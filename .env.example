# CloudBQ — operator settings (copy to .env; .env is gitignored). Placeholders must be replaced; deploy.sh refuses them.
PROJECT=your-gcp-project-id            # GCP project that holds the hubspot dataset
REGION=europe-west6                    # Cloud Run / Scheduler region (Zurich); europe-west1 if cost wins
BQ_LOCATION=EU                         # location of the hubspot dataset (CREATE SCHEMA IF NOT EXISTS uses it)
DATASET=hubspot                        # BigQuery dataset: report_state, new_deals, new_deals_runs, views
FN=new-deals-report                    # Cloud Run service (function) name
SA_NAME=new-deals-fn                   # runtime service account (created if missing)
PORTAL_ID=9201667                      # HubSpot portal for deal_url
DELIVERY_WEBHOOK_URL=                  # optional: n8n webhook that turns the payload into XLSX + email (scenario B1)
DELIVERY_WEBHOOK_TOKEN_SECRET=         # optional: Secret Manager name of the shared header token for that webhook
SECRET_VERSION=                        # hubspot-token version to pin (empty → latest *enabled* version number at deploy time)
# HUBSPOT_TOKEN=                       # only needed once, to create/rotate the Secret Manager secret; never commit a value
SCHEDULE_SEALSQ="0 7 * * 1"            # Europe/Zurich; ICALPS is offset so the two jobs never share a minute
SCHEDULE_ICALPS="20 7 * * 1"
