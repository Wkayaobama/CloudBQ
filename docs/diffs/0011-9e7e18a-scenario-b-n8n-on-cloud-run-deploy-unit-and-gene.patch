+++ b/deploy/n8n/service.yaml
@@ -0,0 +1,59 @@
+# n8n on Cloud Run — Knative Service manifest, applied with `gcloud run services replace` (declarative → idempotent).
+# Rendered by deploy_n8n.sh: ${PROJECT} ${PROJECT_NUMBER} ${REGION} ${N8N_IMAGE} ${MIN_SCALE}.
+# Design (discovery/scenario_B.md): pinned image; Cloud SQL Postgres (SQLite on Cloud Run loses everything at scale-to-zero);
+# N8N_ENCRYPTION_KEY and DB password from Secret Manager; one instance, one execution at a time; CPU always allocated so work
+# after the webhook response is not throttled; health path moved off /healthz; Cloud Scheduler → webhook keeps minScale 0.
+apiVersion: serving.knative.dev/v1
+kind: Service
+metadata:
+  name: n8n
+  annotations:
+    run.googleapis.com/ingress: all
+spec:
+  template:
+    metadata:
+      annotations:
+        autoscaling.knative.dev/minScale: "${MIN_SCALE}"        # 0 with Cloud Scheduler → webhook; 1 only for the in-app Schedule Trigger variant
+        autoscaling.knative.dev/maxScale: "1"                 # n8n regular mode: one main instance
+        run.googleapis.com/cpu-throttling: "false"            # instance-based billing; n8n keeps working after it has responded
+        run.googleapis.com/cloudsql-instances: ${PROJECT}:${REGION}:n8n-db
+        run.googleapis.com/startup-cpu-boost: "true"
+    spec:
+      serviceAccountName: n8n-run@${PROJECT}.iam.gserviceaccount.com
+      containerConcurrency: 80
