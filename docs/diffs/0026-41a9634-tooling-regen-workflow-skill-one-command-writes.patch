+name: Regenerate and commit
+# generated by .claude/skills/regen-workflow (new_regen_workflow.py --emit-reusable). A reusable workflow: run a generator, then
+# commit what changed (mode commit) or fail if anything changed (mode check; forced on pull_request, whose merge ref cannot be pushed to).
+# Callers in this repository: uses: ./.github/workflows/regenerate.yml · elsewhere: uses: <owner>/<repo>/.github/workflows/regenerate.yml@<ref>
+on:
+  workflow_call:
+    inputs:
+      run:
+        description: Command(s) that regenerate files (multi-line allowed)
+        required: true
+        type: string
+      paths:
+        description: Paths to stage, space-separated git pathspecs (deletions inside them are staged too)
+        required: true
+        type: string
+      message:
+        description: Commit subject
+        required: false
+        type: string
+        default: 'chore: regenerate generated files'
+      mode:
+        description: commit (push the result) or check (fail when regeneration changes anything)
+        required: false
+        type: string
+        default: commit
+      python-version:
+        description: Python to set up ('' to skip)
+        required: false
+        type: string
+        default: '3.12'
+      node-version:
+        description: Node to set up ('' to skip)
+        required: false
+        type: string
+        default: ''
+      install:
+        description: pip install arguments, e.g. '-r requirements.txt pyyaml' ('' to skip)
+        required: false
+        type: string
+        default: ''
+      working-directory:
+        description: Directory the run command executes in
+        required: false
+        type: string
+        default: '.'
+      fetch-depth:
+        description: Git history depth for the checkout (0 = full; scripts that read history need it)
+        required: false
+        type: number
+        default: 1
+      bot-name:
+        required: false
+        type: string
+        default: 'github-actions[bot]'
+      bot-email:
+        required: false
+        type: string
+        default: '41898282+github-actions[bot]@users.noreply.github.com'
+    secrets:
+      REGEN_TOKEN:
+        description: Optional PAT; with it the regenerated commit triggers workflows (GITHUB_TOKEN pushes never do)
+        required: false
+
+concurrency:
+  group: regenerate-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  regenerate:
+    runs-on: ubuntu-latest
+    if: ${{ github.event_name != 'push' || !contains(github.event.head_commit.message, 'Regenerated-by:') }}   # a PAT push of the bot commit must not re-run this
+    permissions:
+      contents: write
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v7
+        with:
+          fetch-depth: ${{ inputs.fetch-depth }}
+          token: ${{ secrets.REGEN_TOKEN || github.token }}
+          persist-credentials: true   # the commit step pushes with the checkout's credentials
+      - name: Set up Python
+        if: inputs.python-version != ''
+        uses: actions/setup-python@v7
+        with:
+          python-version: ${{ inputs.python-version }}
+      - name: Set up Node
+        if: inputs.node-version != ''
+        uses: actions/setup-node@v7
+        with:
+          node-version: ${{ inputs.node-version }}
+      - name: Install
+        if: inputs.install != ''
+        run: python -m pip install -q ${{ inputs.install }}
+      - name: Regenerate
+        working-directory: ${{ inputs.working-directory }}
+        run: ${{ inputs.run }}
+      - name: Commit or check
+        env:
+          PATHS: ${{ inputs.paths }}
+          MESSAGE: ${{ inputs.message }}
+          MODE: ${{ github.event_name == 'pull_request' && 'check' || inputs.mode }}
+          BOT_NAME: ${{ inputs.bot-name }}
+          BOT_EMAIL: ${{ inputs.bot-email }}
+          BRANCH: ${{ github.head_ref || (github.ref_type == 'branch' && github.ref_name) || '' }}
+        run: |
+          #!/usr/bin/env bash
+          # commit_if_changed.sh — the commit-back step every "regenerate and commit" workflow shares (single source; the generator embeds it).
+          #   PATHS     paths to stage, space-separated (git pathspecs, globs included; deletions inside them are staged too)   required
+          #   MESSAGE   commit subject                                                                                       default "chore: regenerate"
+          #   MODE      commit → commit + push the result · check → exit 1 when regeneration changed anything                default commit
+          #   BRANCH    branch to push to                                                                                    default the checked-out branch
+          #   BOT_NAME / BOT_EMAIL   committer identity                                                                      default github-actions[bot]
+          # The commit carries a "Regenerated-by:" trailer naming the workflow run, so tooling can tell generated commits from authored ones.
+          # A push made with GITHUB_TOKEN starts no workflow run; a push made with a PAT does, and the generated workflows skip a push whose head
+          # commit carries the trailer — so a push-triggered regeneration cannot loop on itself either way.
+          # Exit codes: 0 nothing to do or pushed · 1 check failed, a git error, or the push was refused · 2 no branch to push to.
+          set -euo pipefail
+          : "${PATHS:?PATHS is required (space-separated paths to stage)}"
+          MESSAGE="${MESSAGE:-chore: regenerate}"; MODE="${MODE:-commit}"
+          BOT_NAME="${BOT_NAME:-github-actions[bot]}"; BOT_EMAIL="${BOT_EMAIL:-41898282+github-actions[bot]@users.noreply.github.com}"
+          BRANCH="${BRANCH:-$(git rev-parse --abbrev-ref HEAD)}"
+          if [[ -n "${GITHUB_RUN_ID:-}" ]]; then TRAILER="Regenerated-by: ${GITHUB_WORKFLOW:-workflow} (${GITHUB_SERVER_URL:-https://github.com}/${GITHUB_REPOSITORY:-}/actions/runs/${GITHUB_RUN_ID})"
+          else TRAILER="Regenerated-by: commit_if_changed.sh (local)"; fi
+
+          # Stage. `set -f` hands each pathspec to git untouched (a shell-expanded glob would miss the files the generator deleted);
+          # only "did not match any files" is tolerated — a path the generator did not produce this time is not an error, anything else is.
+          set -f
+          # shellcheck disable=SC2086  # PATHS is a list on purpose
+          for p in $PATHS; do
+            if ! out=$(git add -A -- "$p" 2>&1); then
+              case $out in
+                *"did not match any files"*) echo "note: nothing matched $p" ;;
+                *) echo "$out" >&2; exit 1 ;;
+              esac
+            fi
+          done
+          set +f
+          if git diff --staged --quiet; then
+            echo "No changes to commit"
+            exit 0
+          fi
+          echo "Changes:"; git diff --staged --stat
+          if [[ "$MODE" == "check" ]]; then
+            echo "::error::regeneration changed the files above — run the generator locally and commit the result" >&2
+            { git diff --staged || true; } | head -200
+            exit 1
+          fi
+          [[ "$BRANCH" != "HEAD" ]] || { echo "::error::detached HEAD: set BRANCH to the branch to push to" >&2; exit 2; }
+          [[ "${GITHUB_REF_TYPE:-branch}" == "branch" ]] || { echo "::error::this run was started from a ${GITHUB_REF_TYPE}, not a branch: nothing to push to" >&2; exit 2; }
+          git config --local user.name "$BOT_NAME"
+          git config --local user.email "$BOT_EMAIL"
+          git commit -q -m "$MESSAGE" -m "$TRAILER"
+          # Push; a rejection is retried only when it was a race (origin/BRANCH moved meanwhile) and the rebase onto it is clean.
+          for attempt in 1 2 3; do
+            if git push origin "HEAD:refs/heads/$BRANCH"; then echo "pushed to $BRANCH"; exit 0; fi
+            before=$(git rev-parse --verify -q "origin/$BRANCH" || true)
+            git fetch origin "$BRANCH"
+            after=$(git rev-parse --verify -q FETCH_HEAD)
+            if [[ "$before" == "$after" ]]; then
+              echo "::error::push to $BRANCH refused and the branch did not move: not a race (branch protection, a pre-receive hook, or the token lacks contents: write)" >&2; exit 1
+            fi
+            echo "push attempt $attempt failed: $BRANCH moved to ${after:0:7}; rebasing"
+            if ! git rebase FETCH_HEAD; then
+              git rebase --abort || true
+              echo "::error::$BRANCH changed a generated path while this run was regenerating; the next run regenerates on top of it" >&2; exit 1
+            fi
+            [[ $attempt -lt 3 ]] && sleep $((attempt * 2))
+          done
+          echo "::error::could not push to $BRANCH after 3 attempts" >&2; exit 1
