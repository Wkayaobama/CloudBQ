+-- company_tiers_apply.sql — the scheduled refresh of pass 2b (lane Q): company_tiers_v1 (live over the sync) → company_tiers (the
+-- snapshot the dashboards read) + company_tiers_history (one slice per refresh, like the raw root of pass 3) + company_tiers_refreshes.
+-- Registered by sql/company_tiers_schedule.sh after the daily HubSpot → BigQuery transfer (02:00 UTC), off the hour; @run_time is
+-- BigQuery's parameter (manual run: bq query --parameter="run_time:TIMESTAMP:$(date -u +%FT%TZ)" < rendered script, or the notebook).
+-- Idempotent: replaying a run_time rewrites the same slice; the snapshot is replaced inside one transaction, so a reader never sees it
+-- half-written. Guards: the 36 h freshness guard of the sync and a row-count guard (a half-empty transfer must not replace the snapshot).
+-- Any error: ROLLBACK, a FAILED refreshes row with the message, RAISE.
+DECLARE v_run_ts TIMESTAMP DEFAULT TIMESTAMP_TRUNC(@run_time, SECOND);
+DECLARE v_orchestrator STRING DEFAULT 'bigquery-scheduled-query';
+DECLARE v_t0 TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
+DECLARE v_freshest TIMESTAMP;
+DECLARE v_batch_rows INT64;
+DECLARE v_current_rows INT64;
+DECLARE v_in_txn BOOL DEFAULT FALSE;
+
+BEGIN
+  SET v_freshest = (SELECT MAX(lastmodified) FROM `${PROJECT}.${DATASET}.deals_synced_v1`);
+  IF v_freshest IS NULL OR v_freshest < TIMESTAMP_SUB(v_run_ts, INTERVAL 36 HOUR) THEN
+    RAISE USING MESSAGE = 'deals sync is older than 36h; aborting the company refresh';
+  END IF;
+
+  CREATE OR REPLACE TEMP TABLE batch AS SELECT * FROM `${PROJECT}.${DATASET}.company_tiers_v1`;
+
+  SET v_batch_rows = (SELECT COUNT(*) FROM batch);
+  SET v_current_rows = (SELECT COUNT(*) FROM `${PROJECT}.${DATASET}.company_tiers`);
+  IF v_current_rows > 0 AND v_batch_rows < v_current_rows / 2 THEN
+    RAISE USING MESSAGE = 'the live view holds fewer than half of the snapshot rows; aborting the company refresh';
+  END IF;
+
+  BEGIN TRANSACTION;
+  SET v_in_txn = TRUE;
+
+  DELETE FROM `${PROJECT}.${DATASET}.company_tiers` WHERE TRUE;
+  INSERT INTO `${PROJECT}.${DATASET}.company_tiers`
+    (refresh_ts, orchestrator, sales_region, entity_key, tier, company_id, company_name, resolver, stages, dealstatuses, entities, pipelines,
+     final_customers, n_deals, max_certainty, avg_certainty, deals, years, total_pipeline_k, amount_native_k, amount_kusd)
+  SELECT v_run_ts, v_orchestrator, sales_region, entity_key, tier, company_id, company_name, resolver, stages, dealstatuses, entities, pipelines,
+         final_customers, n_deals, max_certainty, avg_certainty, deals, years, total_pipeline_k, amount_native_k, amount_kusd
+  FROM batch;
+
+  DELETE FROM `${PROJECT}.${DATASET}.company_tiers_history` WHERE refresh_ts = v_run_ts AND orchestrator = v_orchestrator;
+  INSERT INTO `${PROJECT}.${DATASET}.company_tiers_history`
+    (refresh_ts, orchestrator, sales_region, entity_key, tier, company_id, company_name, resolver, stages, dealstatuses, entities, pipelines,
+     final_customers, n_deals, max_certainty, avg_certainty, deals, years, total_pipeline_k, amount_native_k, amount_kusd)
+  SELECT v_run_ts, v_orchestrator, sales_region, entity_key, tier, company_id, company_name, resolver, stages, dealstatuses, entities, pipelines,
+         final_customers, n_deals, max_certainty, avg_certainty, deals, years, total_pipeline_k, amount_native_k, amount_kusd
+  FROM batch;
+
+  DELETE FROM `${PROJECT}.${DATASET}.company_tiers_refreshes` WHERE refresh_ts = v_run_ts AND orchestrator = v_orchestrator;
+  INSERT INTO `${PROJECT}.${DATASET}.company_tiers_refreshes` (refresh_ts, orchestrator, status, error, n_rows, n_companies, n_unresolved, n_deals, duration_ms)
+  SELECT v_run_ts, v_orchestrator, 'OK', NULL, COUNT(*), COUNT(DISTINCT company_id), COUNTIF(resolver NOT IN ('1_primary_assoc', '2_clinic_fc_map', '3_direct_company_name')),
+         SUM(n_deals), TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), v_t0, MILLISECOND)   -- inside a transaction CURRENT_TIMESTAMP() is its start
+  FROM batch;
+
+  COMMIT TRANSACTION;
+  SET v_in_txn = FALSE;
+EXCEPTION WHEN ERROR THEN
+  IF v_in_txn THEN
+    BEGIN ROLLBACK TRANSACTION; EXCEPTION WHEN ERROR THEN END;
+  END IF;
+  INSERT INTO `${PROJECT}.${DATASET}.company_tiers_refreshes` (refresh_ts, orchestrator, status, error, n_rows, n_companies, n_unresolved, n_deals, duration_ms)
+  VALUES (v_run_ts, v_orchestrator, 'FAILED', SUBSTR(@@error.message, 1, 1000), 0, 0, 0, 0, TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), v_t0, MILLISECOND));
+  RAISE;
+END;
diff --git a/sql/company_tiers_body.sql b/sql/company_tiers_body.sql
new file mode 100644
index 0000000..d6c3871
--- /dev/null
+++ b/sql/company_tiers_body.sql
@@ -0,0 +1,107 @@
+-- company_tiers_body.sql — the company object by foreign-key resolution, as CTEs over a `deal_source` the including statement defines.
+-- Included (sed `r` at the marker `-- @include company_tiers_body.sql`) by sql/company_tiers_v1.sql, where deal_source is the sync
+-- (deal_tiers_v1 ⋈ deals_synced_v1), and by notebooks/company_tiers.ipynb, where deal_source is UNNEST(@deals_payload) — the lab's
+-- snapshot as a query parameter, so the dry run computes the same rows and writes nothing. deal_source must expose:
+--   deal_id STRING, pipeline_id STRING, dealstage_id STRING, dealname STRING, final_customer STRING, sales_region STRING,
+--   icalps_dealstatus STRING, certainty_source STRING, certainty FLOAT64, bin_index INT64, tier STRING, is_closed BOOL,
+--   is_closed_won BOOL, amount_kusd FLOAT64
+-- The chain: labelled (pipeline/stage labels) → arr (the ARR dashboard staging: entity, the primary company association, the yearly
+-- figures) → in_status (the icalps_dealstatus rule) → three resolvers → resolved (one row per deal, its company) → rollup (one row per
+-- sales_region × company × tier, the deals nested). Placeholders: ${PROJECT} ${DATASET} ${ARR_PROJECT} ${ARR_DATASET}.
+labelled AS (
+  SELECT d.*,
+         COALESCE(p.label, d.pipeline_id)   AS pipeline,
+         COALESCE(st.label, d.dealstage_id) AS deal_stage,
+         COALESCE(NULLIF(TRIM(d.sales_region), ''), '(no region)') AS region,
+         NULLIF(TRIM(d.icalps_dealstatus), '') AS dealstatus,
+         REGEXP_REPLACE(LOWER(TRIM(COALESCE(d.icalps_dealstatus, ''))), r'[_-]+', ' ') AS dealstatus_norm   -- 'In Progress' = 'in_progress' = 'In-progress'
+  FROM deal_source d
+  LEFT JOIN `${PROJECT}.${DATASET}.pipelines_synced_v1` p        ON p.pipeline_id = d.pipeline_id
+  LEFT JOIN `${PROJECT}.${DATASET}.pipeline_stages_synced_v1` st ON st.stage_id = d.dealstage_id
+),
+arr AS (
+  SELECT CAST(deal_id AS STRING) AS deal_id, CAST(entity AS STRING) AS entity, CAST(company_ids AS STRING) AS company_ids,
+         CAST(final_customer AS STRING) AS arr_final_customer, SAFE_CAST(amount AS FLOAT64) AS amount_native_k,
+         SAFE_CAST(pipeline_2026_k AS FLOAT64) AS pipeline_2026_k, SAFE_CAST(pipeline_2027_k AS FLOAT64) AS pipeline_2027_k,
+         SAFE_CAST(pipeline_2028_k AS FLOAT64) AS pipeline_2028_k, SAFE_CAST(pipeline_2029_k AS FLOAT64) AS pipeline_2029_k,
+         SAFE_CAST(weighted_2026_k AS FLOAT64) AS weighted_2026_k, SAFE_CAST(weighted_2027_k AS FLOAT64) AS weighted_2027_k,
+         SAFE_CAST(weighted_2028_k AS FLOAT64) AS weighted_2028_k, SAFE_CAST(weighted_2029_k AS FLOAT64) AS weighted_2029_k
+  FROM `${ARR_PROJECT}.${ARR_DATASET}.stg_deals`
+  QUALIFY ROW_NUMBER() OVER (PARTITION BY CAST(deal_id AS STRING) ORDER BY deal_id) = 1
+),
+in_status AS (
+  SELECT l.*, a.* EXCEPT (deal_id),
+         COALESCE(NULLIF(TRIM(l.final_customer), ''), NULLIF(TRIM(a.arr_final_customer), '')) AS fc,
+         -- the icalps_dealstatus rule: an Icalps deal counts only while "In Progress"; every other pipeline carries no status (or the same word)
+         CASE WHEN l.pipeline_id = '766126206' THEN l.dealstatus_norm = 'in progress'
+              ELSE l.dealstatus_norm IN ('', 'in progress') END AS status_ok
+  FROM labelled l
+  LEFT JOIN arr a USING (deal_id)
+),
+companies AS (
+  SELECT company_id, company_name, LOWER(TRIM(company_name)) AS name_norm
+  FROM `${PROJECT}.${DATASET}.companies_synced_v1`
+  WHERE COALESCE(company_name, '') != ''
+),
+-- resolver 1: the deal's own primary company association (exact, the foreign key HubSpot holds)
+primary_assoc AS (
+  SELECT deal_id, SPLIT(company_ids, ';')[SAFE_OFFSET(0)] AS company_id
+  FROM in_status
+  WHERE COALESCE(company_ids, '') != ''
+),
+-- resolver 2: the ARR clinic's final-customer → portal company map
+clinic_map AS (
+  SELECT LOWER(TRIM(CAST(final_customer AS STRING))) AS fc_norm,
+         ANY_VALUE(CAST(portal_company_id AS STRING))   AS company_id,
+         ANY_VALUE(CAST(portal_company_name AS STRING)) AS company_name
+  FROM `${ARR_PROJECT}.${ARR_DATASET}.rec_three_layer`
+  WHERE COALESCE(CAST(final_customer AS STRING), '') != '' AND COALESCE(CAST(portal_company_id AS STRING), '') != ''
+  GROUP BY fc_norm
+),
+-- resolver 3: an exact match of the final customer on the company name (one company per normalised name)
+companies_norm AS (
+  SELECT name_norm, ANY_VALUE(company_id) AS company_id, ANY_VALUE(company_name) AS company_name
+  FROM companies
+  GROUP BY name_norm
+),
+resolved AS (
+  SELECT d.* EXCEPT (dealstatus_norm, arr_final_customer),
+         COALESCE(p.company_id, c.company_id, n.company_id)            AS company_id,
+         COALESCE(cn.company_name, c.company_name, n.company_name)     AS company_name,
+         CASE WHEN p.company_id IS NOT NULL THEN '1_primary_assoc'
+              WHEN c.company_id IS NOT NULL THEN '2_clinic_fc_map'
+              WHEN n.company_id IS NOT NULL THEN '3_direct_company_name'
+              WHEN COALESCE(d.fc, '') != '' THEN '4_unresolved_fc'
+              ELSE '5_no_fc_or_company' END                             AS resolver,
+         COALESCE(p.company_id, c.company_id, n.company_id,
+                  IF(COALESCE(d.fc, '') != '', CONCAT('fc:', LOWER(TRIM(d.fc))), CONCAT('deal:', d.deal_id))) AS entity_key
+  FROM in_status d
+  LEFT JOIN primary_assoc p  ON p.deal_id = d.deal_id
+  LEFT JOIN companies cn     ON cn.company_id = p.company_id
+  LEFT JOIN clinic_map c     ON p.company_id IS NULL AND LOWER(TRIM(d.fc)) = c.fc_norm
+  LEFT JOIN companies_norm n ON p.company_id IS NULL AND c.company_id IS NULL AND LOWER(TRIM(d.fc)) = n.name_norm
+),
+rollup AS (
+  SELECT region AS sales_region, entity_key, tier,
+         ANY_VALUE(company_id)   AS company_id,
+         ANY_VALUE(company_name) AS company_name,
+         ANY_VALUE(resolver)     AS resolver,
+         ARRAY_AGG(DISTINCT deal_stage IGNORE NULLS ORDER BY deal_stage) AS stages,
+         ARRAY_AGG(DISTINCT dealstatus IGNORE NULLS ORDER BY dealstatus) AS dealstatuses,
+         ARRAY_AGG(DISTINCT entity IGNORE NULLS ORDER BY entity)         AS entities,
+         ARRAY_AGG(DISTINCT pipeline IGNORE NULLS ORDER BY pipeline)     AS pipelines,
+         ARRAY_AGG(DISTINCT fc IGNORE NULLS ORDER BY fc)                 AS final_customers,
+         COUNT(DISTINCT deal_id)    AS n_deals,
+         MAX(certainty)             AS max_certainty,
+         ROUND(AVG(certainty), 3)   AS avg_certainty,
+         ARRAY_AGG(STRUCT(deal_id, dealname, deal_stage, certainty, amount_kusd) ORDER BY amount_kusd DESC, deal_id) AS deals,
+         ARRAY<STRUCT<year INT64, pipeline_k FLOAT64, weighted_k FLOAT64>>[
+           (2026, SUM(pipeline_2026_k), SUM(weighted_2026_k)), (2027, SUM(pipeline_2027_k), SUM(weighted_2027_k)),
+           (2028, SUM(pipeline_2028_k), SUM(weighted_2028_k)), (2029, SUM(pipeline_2029_k), SUM(weighted_2029_k))] AS years,
+         SUM(COALESCE(pipeline_2026_k, 0) + COALESCE(pipeline_2027_k, 0) + COALESCE(pipeline_2028_k, 0) + COALESCE(pipeline_2029_k, 0)) AS total_pipeline_k,
+         SUM(amount_native_k) AS amount_native_k,
+         SUM(amount_kusd)     AS amount_kusd
+  FROM resolved
+  WHERE status_ok
+  GROUP BY sales_region, entity_key, tier
+)
diff --git a/sql/company_tiers_schedule.sh b/sql/company_tiers_schedule.sh
new file mode 100755
index 0000000..9a16701
--- /dev/null
+++ b/sql/company_tiers_schedule.sh
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+# company_tiers_schedule.sh — register (or update) the daily refresh of the company snapshot: a BigQuery scheduled query running
+# sql/company_tiers_apply.sql (pass 2b, lane Q), after the HubSpot → BigQuery transfer (02:00 UTC), off the hour.
+#   sql/company_tiers_schedule.sh                 create-or-update; schedule SCHEDULE_UTC_COMPANY_TIERS (default "every day 03:37", UTC)
+#   DISABLE_SCHEDULE=1 sql/company_tiers_schedule.sh   register without auto-scheduling (the gate: run one refresh by hand first)
+#   DRYRUN=1 sql/company_tiers_schedule.sh        render, check placeholders, bq query --dry_run, register nothing
+# Settings from ../.env: PROJECT DATASET BQ_LOCATION SQL_SA_NAME (default new-deals-sql) SYNC_DATASET; the view must exist (sql/apply.sh
+# with SYNC_COMPANIES_TABLE set, or the notebook's ship cell) — the live path refuses to register ahead of it.
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; ROOT="$(cd "$HERE/.." && pwd)"
+[[ -f "$ROOT/.env" ]] && { set -a; . "$ROOT/.env"; set +a; }
+: "${PROJECT:?}" "${DATASET:=hubspot}" "${BQ_LOCATION:=EU}" "${SQL_SA_NAME:=new-deals-sql}" "${SCHEDULE_UTC_COMPANY_TIERS:=every day 03:37}" "${SYNC_DATASET:?}"
+[[ "$PROJECT" != your-* ]] || { echo "PROJECT holds a placeholder" >&2; exit 2; }
+[[ "$SCHEDULE_UTC_COMPANY_TIERS" != *:00 ]] || { echo "SCHEDULE_UTC_COMPANY_TIERS is on the hour ($SCHEDULE_UTC_COMPANY_TIERS): BigQuery may trigger it twice — use e.g. 03:37" >&2; exit 2; }
+DRYRUN="${DRYRUN:-0}"; SA="${SQL_SA_NAME}@${PROJECT}.iam.gserviceaccount.com"; NAME="company-tiers-refresh"
+
+Q=$(sed -e "s/\${PROJECT}/$PROJECT/g" -e "s/\${DATASET}/$DATASET/g" "$HERE/company_tiers_apply.sql")
+grep -q '\${' <<<"$Q" && { echo "unrendered placeholder in company_tiers_apply.sql" >&2; exit 2; }
+
+if [[ "$DRYRUN" == 1 ]]; then
+  echo "── $NAME: $(wc -l <<<"$Q") lines; schedule '$SCHEDULE_UTC_COMPANY_TIERS' (UTC); bq query --dry_run:"
+  if ! out=$(bq --project_id="$PROJECT" --location="$BQ_LOCATION" query --use_legacy_sql=false --dry_run --parameter="run_time:TIMESTAMP:$(date -u +%FT%TZ)" <<<"$Q" 2>&1); then
+    if grep -qiE "credential|authoriz|auth |login|active account" <<<"$out"; then echo "   (dry_run needs credentials; rendered script saved to /tmp/company_tiers_apply.sql)"
+    else echo "$out" >&2; echo "   bq --dry_run rejected the rendered script" >&2; exit 1; fi
+  else echo "$out"; fi
+  printf '%s\n' "$Q" > /tmp/company_tiers_apply.sql
+  echo "next: sql/company_tiers_schedule.sh (DISABLE_SCHEDULE=1 first), one manual run, then without DISABLE_SCHEDULE"; exit 0
+fi
+
+gcloud iam service-accounts describe "$SA" --project "$PROJECT" >/dev/null 2>&1 || gcloud iam service-accounts create "$SQL_SA_NAME" --project "$PROJECT" --display-name "new deals scheduled queries"
+gcloud projects add-iam-policy-binding "$PROJECT" --member "serviceAccount:$SA" --role roles/bigquery.jobUser --condition=None >/dev/null
+bq --project_id="$PROJECT" --location="$BQ_LOCATION" query --use_legacy_sql=false "GRANT \`roles/bigquery.dataEditor\` ON SCHEMA \`${PROJECT}.${DATASET}\` TO \"serviceAccount:${SA}\""
+bq --project_id="$PROJECT" --location="$BQ_LOCATION" query --use_legacy_sql=false "GRANT \`roles/bigquery.dataViewer\` ON SCHEMA \`${PROJECT}.${SYNC_DATASET}\` TO \"serviceAccount:${SA}\""
+[[ -n "${ARR_DATASET:-}" ]] && bq --project_id="${ARR_PROJECT:-$PROJECT}" --location="$BQ_LOCATION" query --use_legacy_sql=false "GRANT \`roles/bigquery.dataViewer\` ON SCHEMA \`${ARR_PROJECT:-$PROJECT}.${ARR_DATASET}\` TO \"serviceAccount:${SA}\""   # the view reads the ARR staging
+bq --project_id="$PROJECT" show "${PROJECT}:${DATASET}.company_tiers_v1" >/dev/null 2>&1 || { echo "company_tiers_v1 does not exist — apply sql/company_tiers_v1.sql first (sql/apply.sh with SYNC_COMPANIES_TABLE, or the notebook)" >&2; exit 2; }
+bq --project_id="$PROJECT" show "${PROJECT}:${DATASET}.company_tiers" >/dev/null 2>&1 || { echo "company_tiers does not exist — apply sql/company_tiers_v1.sql first" >&2; exit 2; }
+
+EXISTING=$(bq ls --transfer_config --transfer_location="$BQ_LOCATION" --project_id="$PROJECT" --format=json 2>/dev/null \
+           | python3 -c 'import sys,json; d=json.load(sys.stdin) or []; print(next((c["name"] for c in d if c.get("displayName")==sys.argv[1]),""))' "$NAME")
+PARAMS=$(python3 -c 'import json,sys; print(json.dumps({"query": sys.stdin.read()}))' <<<"$Q")
+# explicit on both paths: DISABLE_SCHEDULE=1 registers (or re-registers) paused; without it the config is (re-)enabled — the notebook's §7
+NAS="--no_auto_scheduling=$([[ -n "${DISABLE_SCHEDULE:-}" ]] && echo true || echo false)"
+if [[ -z "$EXISTING" ]]; then
+  bq mk --transfer_config --project_id="$PROJECT" --location="$BQ_LOCATION" --data_source=scheduled_query --display_name="$NAME" \
+     --schedule="$SCHEDULE_UTC_COMPANY_TIERS" --service_account_name="$SA" --params="$PARAMS" "$NAS"
+else
+  bq update --transfer_config --params="$PARAMS" --schedule="$SCHEDULE_UTC_COMPANY_TIERS" --service_account_name="$SA" "$NAS" "$EXISTING"
+fi
+cat <<TXT
+manual refresh (writes the snapshot; the notebook's probe reads company_tiers_refreshes afterwards):
+  bq mk --transfer_run --run_time=\$(date -u +%FT%TZ) <transfer_config_resource_name>
+probe: SELECT refresh_ts, status, n_rows, n_companies, n_unresolved, n_deals, duration_ms FROM \`$PROJECT.$DATASET.company_tiers_refreshes\` ORDER BY refresh_ts DESC LIMIT 5
+TXT
diff --git a/sql/company_tiers_v1.sql b/sql/company_tiers_v1.sql
new file mode 100644
index 0000000..65bae43
--- /dev/null
+++ b/sql/company_tiers_v1.sql
@@ -0,0 +1,69 @@
+-- company_tiers_v1.sql — pass 2b: the company object by foreign-key resolution, over the L2 tiers (lane Q, BigQuery-native).
+-- Applied by sql/apply.sh after deal_tiers_v1.sql when SYNC_COMPANIES_TABLE is set (the sync's Companies asset); the notebook
+-- notebooks/company_tiers.ipynb applies the same rendered file from Python (lane N) after its dry run passed.
+-- The CTE chain lives in sql/company_tiers_body.sql (spliced at the marker) so the dry run and the views are one SQL text; this file only
+-- names the sources and the sinks. Placeholders: ${PROJECT} ${DATASET} ${SYNC_DATASET} ${SYNC_COMPANIES_TABLE} ${SYNC_COMPANY_ID_COLUMN}
+-- ${ARR_PROJECT} ${ARR_DATASET}. Nothing here writes into the sync tables: every derived column lives in ${DATASET}.
+
+-- the Companies asset of the sync (Data Hub sync: id/name; DTS connector: hs_object_id/name — SYNC_COMPANY_ID_COLUMN names it)
+CREATE OR REPLACE VIEW `${PROJECT}.${DATASET}.companies_synced_v1` AS
+SELECT CAST(${SYNC_COMPANY_ID_COLUMN} AS STRING) AS company_id, CAST(name AS STRING) AS company_name
+FROM `${PROJECT}.${SYNC_DATASET}.${SYNC_COMPANIES_TABLE}`
+WHERE ${SYNC_COMPANY_ID_COLUMN} IS NOT NULL;
+
+-- the deal input every surface shares: the L2 tier per deal (deal_tiers_v1) with the deal's own customer, region and status
+CREATE OR REPLACE VIEW `${PROJECT}.${DATASET}.company_deal_input_v1` AS
+SELECT t.deal_id, t.pipeline_id, t.dealstage_id, t.dealname, d.final_customer, d.sales_region, d.icalps_dealstatus,
+       t.certainty_source, t.certainty, t.bin_index, t.tier, t.is_closed, t.is_closed_won, t.amount_kusd
+FROM `${PROJECT}.${DATASET}.deal_tiers_v1` t
+JOIN `${PROJECT}.${DATASET}.deals_synced_v1` d USING (deal_id)
+QUALIFY ROW_NUMBER() OVER (PARTITION BY t.deal_id ORDER BY t.lastmodified DESC) = 1;   -- one row per deal even if the transfer appended
+
+-- one row per deal: its company, how it was resolved, the key the rollup groups by
+CREATE OR REPLACE VIEW `${PROJECT}.${DATASET}.company_deals_v1` AS
+WITH deal_source AS (SELECT * FROM `${PROJECT}.${DATASET}.company_deal_input_v1`),
+-- @include company_tiers_body.sql
+SELECT * FROM resolved;
+
+-- the company object: one row per sales_region × company (entity_key) × tier, its deals nested — the live view
+CREATE OR REPLACE VIEW `${PROJECT}.${DATASET}.company_tiers_v1` AS
+WITH deal_source AS (SELECT * FROM `${PROJECT}.${DATASET}.company_deal_input_v1`),
+-- @include company_tiers_body.sql
+SELECT * FROM rollup;
+
+-- the snapshot the dashboards read (replaced by every refresh, sql/company_tiers_apply.sql) and its per-refresh slices
+CREATE TABLE IF NOT EXISTS `${PROJECT}.${DATASET}.company_tiers` (
+  refresh_ts TIMESTAMP NOT NULL, orchestrator STRING NOT NULL,
+  sales_region STRING, entity_key STRING NOT NULL, tier STRING,
+  company_id STRING, company_name STRING, resolver STRING,
+  stages ARRAY<STRING>, dealstatuses ARRAY<STRING>, entities ARRAY<STRING>, pipelines ARRAY<STRING>, final_customers ARRAY<STRING>,
+  n_deals INT64, max_certainty FLOAT64, avg_certainty FLOAT64,
+  deals ARRAY<STRUCT<deal_id STRING, dealname STRING, deal_stage STRING, certainty FLOAT64, amount_kusd FLOAT64>>,
+  years ARRAY<STRUCT<year INT64, pipeline_k FLOAT64, weighted_k FLOAT64>>,
+  total_pipeline_k FLOAT64, amount_native_k FLOAT64, amount_kusd FLOAT64)
+CLUSTER BY sales_region, entity_key;
+
+CREATE TABLE IF NOT EXISTS `${PROJECT}.${DATASET}.company_tiers_history` (
+  refresh_ts TIMESTAMP NOT NULL, orchestrator STRING NOT NULL,
+  sales_region STRING, entity_key STRING NOT NULL, tier STRING,
+  company_id STRING, company_name STRING, resolver STRING,
+  stages ARRAY<STRING>, dealstatuses ARRAY<STRING>, entities ARRAY<STRING>, pipelines ARRAY<STRING>, final_customers ARRAY<STRING>,
+  n_deals INT64, max_certainty FLOAT64, avg_certainty FLOAT64,
+  deals ARRAY<STRUCT<deal_id STRING, dealname STRING, deal_stage STRING, certainty FLOAT64, amount_kusd FLOAT64>>,
+  years ARRAY<STRUCT<year INT64, pipeline_k FLOAT64, weighted_k FLOAT64>>,
+  total_pipeline_k FLOAT64, amount_native_k FLOAT64, amount_kusd FLOAT64)
+PARTITION BY DATE(refresh_ts) CLUSTER BY sales_region, entity_key
+OPTIONS (partition_expiration_days = 730);
+
+-- one row per refresh, also on failure — the probe of lane N and the equality check of the workbook
+CREATE TABLE IF NOT EXISTS `${PROJECT}.${DATASET}.company_tiers_refreshes` (
+  refresh_ts TIMESTAMP NOT NULL, orchestrator STRING NOT NULL, status STRING NOT NULL, error STRING,
+  n_rows INT64, n_companies INT64, n_unresolved INT64, n_deals INT64, duration_ms INT64)
+PARTITION BY DATE(refresh_ts);
+
+-- what every surface compares: rows, companies and deals per region, tier and resolver — live, and over the snapshot
+CREATE OR REPLACE VIEW `${PROJECT}.${DATASET}.company_tiers_summary_v1` AS
+SELECT sales_region, tier, resolver, COUNT(*) AS rows_, COUNT(DISTINCT company_id) AS companies, SUM(n_deals) AS deals,
+       ROUND(SUM(amount_kusd), 1) AS amount_kusd, ROUND(SUM(total_pipeline_k), 1) AS total_pipeline_k
+FROM `${PROJECT}.${DATASET}.company_tiers_v1`
+GROUP BY sales_region, tier, resolver;
