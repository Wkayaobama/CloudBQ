@@ -0,0 +1,25 @@
+-- generated by tests/test_hot_score.py from tests/hot_score_vectors.json; run after scoring/hot_score_v1.sql:
+--   bq query --use_legacy_sql=false < tests/hot_score_vectors.sql   → every row ok = TRUE
+WITH v AS (SELECT * FROM UNNEST([
+  STRUCT('hw_qualified_big_arr_2027' AS id, '12096408' AS pipeline, '0.2' AS prob, '2027-03-31T00:00:00Z' AS closedate, NULL AS calc_2026, NULL AS services_2026, '16002' AS arr, NULL AS tpm, 'Secure Elements' AS product_hierarchy, '3' AS notes, '2026-10-01T10:00:00Z' AS notes_last_updated, 'Pipeline' AS revenue_state, 90.3 AS exp_score, TRUE AS exp_hot),
+  STRUCT('hw_identified_no_data' AS id, '12096408' AS pipeline, '0.1' AS prob, NULL AS closedate, NULL AS calc_2026, NULL AS services_2026, NULL AS arr, NULL AS tpm, NULL AS product_hierarchy, NULL AS notes, NULL AS notes_last_updated, NULL AS revenue_state, 2.8 AS exp_score, FALSE AS exp_hot),
+  STRUCT('hw_forecast_2026_mid_arr' AS id, '12096408' AS pipeline, '0.6' AS prob, '2026-11-15T00:00:00Z' AS closedate, '250' AS calc_2026, NULL AS services_2026, '400' AS arr, NULL AS tpm, NULL AS product_hierarchy, '40' AS notes, '2026-05-01T00:00:00Z' AS notes_last_updated, 'Forecast' AS revenue_state, 33.3 AS exp_score, FALSE AS exp_hot),
