+name: 'Update README index'
+# generated by .claude/skills/regen-workflow (new_regen_workflow.py --mode local); the steps live in the reusable workflow it calls
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+concurrency:
+  group: regenerate-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: false
+
