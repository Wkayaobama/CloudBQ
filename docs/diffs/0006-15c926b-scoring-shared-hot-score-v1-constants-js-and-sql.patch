+  STRUCT('pki_mid_arr_boundary_50' AS id, '12096408' AS pipeline, '0.5' AS prob, NULL AS closedate, '50' AS calc_2026, NULL AS services_2026, '50' AS arr, NULL AS tpm, 'PKI' AS product_hierarchy, NULL AS notes, NULL AS notes_last_updated, NULL AS revenue_state, 18.6 AS exp_score, FALSE AS exp_hot),
+  STRUCT('pki_large_arr' AS id, '13772279' AS pipeline, '0.8' AS prob, NULL AS closedate, NULL AS calc_2026, '51' AS services_2026, '51' AS arr, NULL AS tpm, 'PKI' AS product_hierarchy, NULL AS notes, NULL AS notes_last_updated, NULL AS revenue_state, 76.0 AS exp_score, TRUE AS exp_hot),
