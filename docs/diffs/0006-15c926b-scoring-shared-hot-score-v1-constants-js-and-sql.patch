diff --git a/scoring/hot_score_v1.mjs b/scoring/hot_score_v1.mjs
new file mode 100644
index 0000000..0b595e4
--- /dev/null
+++ b/scoring/hot_score_v1.mjs
@@ -0,0 +1,53 @@
+// hot_score_v1.mjs — JS port of hot_score() from cloud_function_new_deals/main.py (same constants, same branches).
+// Used by the Cloud Run write-back job (scenario C) and as the source of the n8n Code-node snippet (scenario B).
+// Verified against tests/hot_score_vectors.json by `python3 tests/test_hot_score.py` (which runs this file with node).
+import { readFileSync } from 'node:fs';
+
+export const C = JSON.parse(readFileSync(new URL('./hot_score_v1.constants.json', import.meta.url), 'utf8'));
+const CRMAX = Math.max(...Object.values(C.conversion).map(c => c.won / c.total));
+
+const num = (v) => { if (v === null || v === undefined || v === '') return 0; const f = Number(v); return Number.isFinite(f) ? f : 0; };
+const daysBetween = (later, earlier) => Math.trunc((later - earlier) / 86400000); // python timedelta.days for positive deltas
+
+/** @returns {{score: number|null, hot: boolean|null, raw: number|null}} score rounded to 1 dp like Python's round(s, 1) */
+export function hotScore(p, now = new Date()) {
+  const cr = C.conversion[p.pipeline];
+  if (!cr) return { score: null, hot: null, raw: null };
+  const arr = num(p.asp_in_usd_q2_2022_calculation) || num(p.tpm__k_y) || num(p.services_value_2026);
+  const tiers = p.product_hierarchy === 'PKI' ? C.arr_tiers.PKI : C.arr_tiers.default;
+  let pts = tiers[tiers.length - 1][1];
+  for (const [limit, value] of tiers) {
+    if (limit === null) { pts = value; break; }
+    const strict = limit === tiers[0][0];           // first tier is "< limit", the rest are "<= limit" (as in main.py)
+    if (strict ? arr < limit : arr <= limit) { pts = value; break; }
+  }
+  let prox = 0;
+  if (p.closedate) {
+    const d = new Date(p.closedate);
+    const horizon = new Date(C.horizon_date + 'T00:00:00Z');
+    prox = d.getUTCFullYear() <= 2026 ? 1 : Math.max(0, 1 - daysBetween(d, horizon) / C.horizon_decay_days);
+  }
+  const hw = p.pipeline === C.hardware_pipeline;
+  const missing = (hw ? !num(p.calculation___pipeline_2026__k__) : !num(p.services_value_2026)) ? 1 : 0;
+  let rec = 0;
+  if (p.notes_last_updated) {
+    const days = daysBetween(now, new Date(p.notes_last_updated));
+    rec = days <= C.recency_days[0][0] ? C.recency_days[0][1] : (days <= C.recency_days[1][0] ? C.recency_days[1][1] : 0);
+  }
+  const f = {
+    stage_prob: num(p.hs_deal_stage_probability), proximity_2026: prox, missing_2026_field: missing,
+    pipeline_conversion: (cr.won / cr.total) / CRMAX, arr_points: pts / C.arr_tier_divisor,
+    engagement: Math.log1p(num(p.num_contacted_notes)) / Math.log1p(C.max_contacted_notes),
+    recency: rec, not_in_forecast: C.forecast_states.includes(p.revenue_state) ? 0 : 1,
+  };
+  const z = Object.keys(C.weights).reduce((acc, k) => acc + C.weights[k] * f[k], 0) + C.bias;
+  const s = 100 / (1 + Math.exp(-z));
+  return { score: Math.round(s * 10) / 10, hot: s >= C.threshold, raw: s };
+}
+
+// CLI: node hot_score_v1.mjs tests/hot_score_vectors.json  → prints one JSON line per vector
+if (process.argv[1] && import.meta.url.endsWith(process.argv[1].split('/').pop())) {
+  const vectors = JSON.parse(readFileSync(process.argv[2], 'utf8'));
+  const now = new Date(vectors.now);
+  process.stdout.write(JSON.stringify(vectors.cases.map(c => ({ id: c.id, ...hotScore(c.props, now) }))) + '\n');
+}
diff --git a/scoring/hot_score_v1.sql b/scoring/hot_score_v1.sql
new file mode 100644
index 0000000..fb232da
--- /dev/null
+++ b/scoring/hot_score_v1.sql
@@ -0,0 +1,43 @@
+-- hot_score_v1.sql — BigQuery SQL port of hot_score() from cloud_function_new_deals/main.py (scenario C compute lane).
+-- Replace ${PROJECT}. Returns NULLs for pipelines without a conversion rate, like the Python function.
+-- Verify with tests/hot_score_vectors.sql (generated from tests/hot_score_vectors.json): every row must show ok = TRUE.
+CREATE OR REPLACE FUNCTION `${PROJECT}.hubspot.hot_score_v1`(
+  pipeline STRING, hs_deal_stage_probability FLOAT64, closedate TIMESTAMP,
+  calculation___pipeline_2026__k__ FLOAT64, services_value_2026 FLOAT64,
+  asp_in_usd_q2_2022_calculation FLOAT64, tpm__k_y FLOAT64, product_hierarchy STRING,
+  num_contacted_notes FLOAT64, notes_last_updated TIMESTAMP, revenue_state STRING, run_ts TIMESTAMP)
+RETURNS STRUCT<score FLOAT64, hot BOOL, raw FLOAT64>
+AS ((
+  WITH c AS (
+    SELECT
+      CASE pipeline WHEN '12096408' THEN 84/730 WHEN '13772279' THEN 51/303 END AS cr,
+      GREATEST(84/730, 51/303) AS crmax,
+      COALESCE(NULLIF(IFNULL(asp_in_usd_q2_2022_calculation, 0), 0), NULLIF(IFNULL(tpm__k_y, 0), 0), IFNULL(services_value_2026, 0)) AS arr
+  ), f AS (
+    SELECT
+      cr,
+      IFNULL(hs_deal_stage_probability, 0) AS stage_prob,
+      CASE WHEN closedate IS NULL THEN 0
+           WHEN EXTRACT(YEAR FROM closedate) <= 2026 THEN 1
+           ELSE GREATEST(0, 1 - TIMESTAMP_DIFF(closedate, TIMESTAMP '2026-12-31 00:00:00+00', DAY) / 730) END AS proximity_2026,
+      CASE WHEN pipeline = '12096408' THEN IF(IFNULL(calculation___pipeline_2026__k__, 0) = 0, 1, 0)
+           ELSE IF(IFNULL(services_value_2026, 0) = 0, 1, 0) END AS missing_2026_field,
+      cr / crmax AS pipeline_conversion,
+      (CASE WHEN product_hierarchy = 'PKI'
+            THEN CASE WHEN arr < 20 THEN 0.5 WHEN arr <= 50 THEN 1 ELSE 2 END
+            ELSE CASE WHEN arr < 100 THEN 0.5 WHEN arr <= 500 THEN 1 WHEN arr <= 1000 THEN 2 ELSE 3 END END) / 3 AS arr_points,
+      LN(1 + IFNULL(num_contacted_notes, 0)) / LN(1 + 223) AS engagement,
+      CASE WHEN notes_last_updated IS NULL THEN 0
+           WHEN TIMESTAMP_DIFF(run_ts, notes_last_updated, DAY) <= 90 THEN 1.0
+           WHEN TIMESTAMP_DIFF(run_ts, notes_last_updated, DAY) <= 180 THEN 0.5 ELSE 0 END AS recency,
+      IF(revenue_state IN ('Forecast', 'BIBA'), 0, 1) AS not_in_forecast
+    FROM c
+  ), z AS (
+    SELECT cr,
+      2.0712 * stage_prob + 1.2399 * proximity_2026 + (-0.4136) * missing_2026_field + 1.0918 * pipeline_conversion
+      + 4.9843 * arr_points + 1.3018 * engagement + 0.0 * recency + 1.5620 * not_in_forecast + (-6.4788) AS z
+    FROM f
+  )
+  SELECT IF(cr IS NULL, NULL, STRUCT(ROUND(100 / (1 + EXP(-z)), 1) AS score, 100 / (1 + EXP(-z)) >= 45.0 AS hot, 100 / (1 + EXP(-z)) AS raw))
+  FROM z
+));
