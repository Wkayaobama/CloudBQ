# CloudBQ — operator settings (copy to .env; .env is gitignored). Placeholders must be replaced; deploy.sh refuses them.
PROJECT=your-gcp-project-id            # GCP project that holds the hubspot dataset
REGION=europe-west6                    # Cloud Run / Scheduler region (Zurich); europe-west1 if cost wins
BQ_LOCATION=EU                         # location of the hubspot dataset (CREATE SCHEMA IF NOT EXISTS uses it)
DATASET=hubspot                        # BigQuery dataset: report_state, new_deals, new_deals_runs, views
FN=new-deals-report                    # Cloud Run service (function) name
SA_NAME=new-deals-fn                   # runtime service account (created if missing)
PORTAL_ID=9201667                      # HubSpot portal for deal_url
DELIVERY_WEBHOOK_URL=                  # optional: n8n webhook that turns the payload into XLSX + email (scenario B1)
DELIVERY_WEBHOOK_TOKEN_SECRET=         # optional: Secret Manager name of the shared header token for that webhook
SECRET_VERSION=                        # hubspot-token version to pin (empty → latest *enabled* version number at deploy time)
# HUBSPOT_TOKEN=                       # only needed once, to create/rotate the Secret Manager secret; never commit a value
SCHEDULE_SEALSQ="0 7 * * 1"            # Europe/Zurich; ICALPS is offset so the two jobs never share a minute
SCHEDULE_ICALPS="20 7 * * 1"

# ── scenario C (sql/, writeback/) ──────────────────────────────────────────────────────────────────────────────
SYNC_DATASET=hubspot_sync              # dataset the HubSpot → BigQuery transfer writes to (sql/sync_transfer.sh creates it)
SYNC_DEALS_TABLE=                      # table name of the synced Deals asset — known after the first transfer run (bq ls)
SYNC_OWNERS_TABLE=                     # table name of the synced Owners asset
SQL_SA_NAME=new-deals-sql              # service account that runs the scheduled queries
SCHEDULE_UTC_SEALSQ=every monday 03:53      # lane C scheduled query, UTC, off the hour; ICALPS below never shares its minute (conflicting transactions cancel)
SCHEDULE_UTC_ICALPS=every monday 04:23
SYNC_SCHEDULE="every day 02:00"        # DTS transfer (UTC)
HUBSPOT_WRITE_TOKEN_VERSION=           # pinned Secret Manager version of hubspot-token-write (a second private app with crm.objects.deals.write)
WRITEBACK_SCHEDULE="30 5 * * 1"        # Europe/Zurich; after the 03:53 / 04:23 UTC queries, before A's report
WRITEBACK_APPROVE=0                    # 0 = the job logs DRY rows; 1 = it PATCHes HubSpot (set after a dry execution looked right)
# ── scenario B (deploy/n8n/, workflows/) ───────────────────────────────────────────────────────────────────────
N8N_IMAGE=docker.io/n8nio/n8n:2.41.7   # pinned tag or digest; never :latest
MIN_SCALE=0                            # 0 with Cloud Scheduler → webhook; 1 only for the in-app Schedule Trigger variant
SQL_TIER=db-f1-micro                   # Cloud SQL tier for n8n's Postgres (cost floor, no SLA)
SQL_INSTANCE=n8n-db
MAIL_FROM=n8n@example.com              # Email Send node sender ($env.MAIL_FROM)
MAIL_TO=sales-ops@example.com          # recipients ($env.MAIL_TO)
# N8N_URL=                             # printed by deploy_n8n.sh; needed by import_workflows.sh and scheduler.sh
# N8N_API_KEY=                         # created once in n8n → Settings → n8n API; keep it out of .env in shared machines
