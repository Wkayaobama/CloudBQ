diff --git a/sql/backfill_raw.sh b/sql/backfill_raw.sh
new file mode 100755
index 0000000..a7ceaea
--- /dev/null
+++ b/sql/backfill_raw.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+# backfill_raw.sh — one-time landing of the 90-day set into deals_raw / labels_raw with orchestrator = 'backfill' (pass 3 phase 1, D3):
+# the duplicate horizon is full from the cut-over run instead of growing for 13 weeks. Lands from the sync table (sql/land_raw.sql).
+#   sql/backfill_raw.sh                          both entities, run_ts = now (second-truncated)
+#   RUN_TS=2026-10-27T04:00:00Z sql/backfill_raw.sh ICALPS     one entity at a given cut-over run_ts
+#   DRYRUN=1 sql/backfill_raw.sh                 render, check placeholders, bq query --dry_run (syntax + bytes), execute nothing
+# Settings from ../.env: PROJECT DATASET BQ_LOCATION SYNC_DATASET SYNC_DEALS_TABLE
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; ROOT="$(cd "$HERE/.." && pwd)"
+[[ -f "$ROOT/.env" ]] && { set -a; . "$ROOT/.env"; set +a; }
+: "${PROJECT:?}" "${DATASET:=hubspot}" "${BQ_LOCATION:=EU}" "${SYNC_DATASET:?}" "${SYNC_DEALS_TABLE:?}"
+[[ "$PROJECT" != your-* ]] || { echo "PROJECT holds a placeholder" >&2; exit 2; }
+DRYRUN="${DRYRUN:-0}"; RUN_TS="${RUN_TS:-$(date -u +%FT%TZ)}"
+declare -A PIPES=([SEALSQ]="['12096408','13772279','705868909','934982230']" [ICALPS]="['766126206']")
+render() {
+  { cat <<SQL
+DECLARE v_entity STRING DEFAULT '$1';
+DECLARE v_pipelines ARRAY<STRING> DEFAULT ${PIPES[$1]};
+DECLARE v_run_ts TIMESTAMP DEFAULT TIMESTAMP_TRUNC(TIMESTAMP '$RUN_TS', SECOND);
+DECLARE v_orchestrator STRING DEFAULT 'backfill';
+DECLARE v_mode STRING DEFAULT 'window';
+DECLARE v_landed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
+SQL
+    cat "$HERE/land_raw.sql"; } | sed -e "s/\${PROJECT}/$PROJECT/g" -e "s/\${DATASET}/$DATASET/g" -e "s/\${SYNC_DATASET}/$SYNC_DATASET/g" -e "s/\${SYNC_DEALS_TABLE}/$SYNC_DEALS_TABLE/g"
+}
+for E in ${1:-SEALSQ ICALPS}; do
+  [[ -n "${PIPES[$E]:-}" ]] || { echo "unknown entity $E" >&2; exit 2; }
+  Q=$(render "$E")
+  grep -q '\${' <<<"$Q" && { echo "unrendered placeholder for $E" >&2; exit 2; }
+  if [[ "$DRYRUN" == 1 ]]; then
+    echo "── backfill $E at $RUN_TS: $(wc -l <<<"$Q") lines; bq query --dry_run:"
+    bq --project_id="$PROJECT" --location="$BQ_LOCATION" query --use_legacy_sql=false --dry_run <<<"$Q" || echo "   (dry_run needs credentials; rendered script saved to /tmp/backfill_raw_$E.sql)"
+    printf '%s\n' "$Q" > "/tmp/backfill_raw_$E.sql"; continue
+  fi
+  echo "── backfill $E at $RUN_TS (orchestrator = backfill)"
+  bq --project_id="$PROJECT" --location="$BQ_LOCATION" query --use_legacy_sql=false <<<"$Q"
+done
+echo "probe: SELECT orchestrator, entity, COUNT(*) FROM \`$PROJECT.$DATASET.deals_raw\` WHERE run_ts = TIMESTAMP '$RUN_TS' GROUP BY 1, 2"
diff --git a/sql/land_raw.sql b/sql/land_raw.sql
new file mode 100644
index 0000000..0786b77
--- /dev/null
+++ b/sql/land_raw.sql
@@ -0,0 +1,31 @@
+-- land_raw.sql — the raw root for lane C (pass 3, layers L4 + L13): the 90-day set the batch computes from, landed from the SYNC TABLE
+-- with HubSpot property names (never from the renamed adapter view), plus the labels the run resolves with. Included by
+-- sql/new_deals_weekly.sql (marker `-- @include land_raw.sql`, spliced by scheduled_query.sh) and by sql/backfill_raw.sh.
+-- Expects the variables v_run_ts, v_entity, v_pipelines, v_orchestrator, v_mode and v_landed_at to be DECLAREd by the including script.
+-- Plain DML outside any transaction: a failed batch must leave its inputs queryable, and a transaction cannot nest. Load first, then
+-- delete older rows of the same (run_ts, entity, orchestrator) key, so a failure between the two statements never leaves an empty slice.
+-- hs_object_source_detail_1 is not landed until the first transfer confirms the column (data_gaps: source_detail_unavailable).
+INSERT INTO `${PROJECT}.${DATASET}.deals_raw`
+  (run_ts, entity, orchestrator, mode, source, deal_id, in_scope, createdate, pipeline_id, properties, fetched_at)
+SELECT v_run_ts, v_entity, v_orchestrator, v_mode, 'dts_sync',
+       CAST(hs_object_id AS STRING), CAST(pipeline AS STRING) IN UNNEST(v_pipelines),
+       SAFE_CAST(createdate AS TIMESTAMP), CAST(pipeline AS STRING),
+       TO_JSON(STRUCT(dealname, createdate, final_customer, sales_region, pipeline, dealstage, hs_deal_stage_probability, amount,
+                      amount_in_home_currency, deal_currency_code, closedate, asp_in_usd_q2_2022_calculation, tpm__k_y, services_value_2026,
+                      calculation___pipeline_2026__k__, product_hierarchy, prod___product_name_new_, application, hubspot_owner_id,
+                      hs_object_source_label, icalps_dealtype, icalps_stage, icalps_dealstatus, num_contacted_notes, notes_last_updated,
+                      revenue_state, hs_created_by_user_id, hs_lastmodifieddate)),
+       v_landed_at
+FROM `${PROJECT}.${SYNC_DATASET}.${SYNC_DEALS_TABLE}`
+WHERE hs_object_id IS NOT NULL
+  AND SAFE_CAST(createdate AS TIMESTAMP) >= TIMESTAMP_SUB(v_run_ts, INTERVAL 90 DAY) AND SAFE_CAST(createdate AS TIMESTAMP) < v_run_ts
+QUALIFY ROW_NUMBER() OVER (PARTITION BY hs_object_id ORDER BY SAFE_CAST(hs_lastmodifieddate AS TIMESTAMP) DESC) = 1;   -- one row per deal (deal_tiers_apply.sql:27)
+DELETE FROM `${PROJECT}.${DATASET}.deals_raw`
+WHERE run_ts = v_run_ts AND entity = v_entity AND orchestrator = v_orchestrator AND fetched_at < v_landed_at;
+
+INSERT INTO `${PROJECT}.${DATASET}.labels_raw` (run_ts, entity, orchestrator, kind, id, label, fetched_at)
+SELECT v_run_ts, v_entity, v_orchestrator, 'pipeline', pipeline_id, label, v_landed_at FROM `${PROJECT}.${DATASET}.pipelines_synced_v1`
+UNION ALL SELECT v_run_ts, v_entity, v_orchestrator, 'stage', stage_id, label, v_landed_at FROM `${PROJECT}.${DATASET}.pipeline_stages_synced_v1`
+UNION ALL SELECT v_run_ts, v_entity, v_orchestrator, 'owner', owner_id, owner_name, v_landed_at FROM `${PROJECT}.${DATASET}.owners_synced_v1`;
+DELETE FROM `${PROJECT}.${DATASET}.labels_raw`
+WHERE run_ts = v_run_ts AND entity = v_entity AND orchestrator = v_orchestrator AND fetched_at < v_landed_at;
diff --git a/sql/new_deals_weekly.sql b/sql/new_deals_weekly.sql
index 5db407b..50eff66 100644
--- a/sql/new_deals_weekly.sql
+++ b/sql/new_deals_weekly.sql
@@ -1,21 +1,35 @@
 -- Scenario C scheduled script: window → shape → duplicates → MERGE → history → run log → state, in ONE transaction.
