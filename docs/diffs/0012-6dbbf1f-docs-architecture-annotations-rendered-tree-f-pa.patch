+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>CloudBQ Architecture Tree</title>
+<style>
+/* tree-f-visualizer template. Everything inline: no fonts, scripts or styles from the network, so the page works
+   offline from a repo and as a published artifact. Colours are tokens on :root; dark follows the viewer's setting. */
+:root {
+  --bg: #f4f6f9; --panel: #ffffff; --fg: #1b2430; --muted: #5b6878; --line: #d6dde6; --accent: #2456a6; --accent-fg: #ffffff;
+  --glyph: #8b98a8; --hover: #e9eef5; --sel: #dfe8f7; --mark: #fff3b0;
+  --par-parallel: #e2f0d9; --par-parallel-line: #7fb069; --par-conditional: #fff2cc; --par-conditional-line: #d6b24a;
+  --par-divergent: #f8cbad; --par-divergent-line: #e08a5a; --par-fg: #1b2430;
+  --st-new: #1f8a4c; --st-modify: #b7791f; --st-proposed: #7a6ff0;
+  --mono: "Cascadia Mono", Consolas, "SF Mono", ui-monospace, Menlo, monospace;
+  --sans: "Segoe UI", ui-sans-serif, system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
+  color-scheme: light;
