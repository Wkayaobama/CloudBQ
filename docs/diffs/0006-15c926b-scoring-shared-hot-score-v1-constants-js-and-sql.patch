+  STRUCT('svc_missing_2026_far_close' AS id, '13772279' AS pipeline, '0.3' AS prob, '2029-06-30T00:00:00Z' AS closedate, NULL AS calc_2026, NULL AS services_2026, NULL AS arr, NULL AS tpm, NULL AS product_hierarchy, '0' AS notes, NULL AS notes_last_updated, NULL AS revenue_state, 5.8 AS exp_score, FALSE AS exp_hot),
