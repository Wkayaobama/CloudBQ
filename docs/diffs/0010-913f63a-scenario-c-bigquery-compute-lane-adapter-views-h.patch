+#!/usr/bin/env bash
+# bootstrap_property.sh — one-time creation of the deal properties the write-back fills (GET before POST → re-runnable).
+# Needs a token with crm.schemas.deals.write in HUBSPOT_SCHEMA_TOKEN (use it once; it is not stored anywhere).
+set -euo pipefail
+: "${HUBSPOT_SCHEMA_TOKEN:?a token with crm.schemas.deals.write, used once}"
+H=(-H "Authorization: Bearer $HUBSPOT_SCHEMA_TOKEN" -H "Content-Type: application/json")
+ensure() {  # name label type fieldType description
+  if curl -sS -o /dev/null -w '%{http_code}' "${H[@]}" "https://api.hubapi.com/crm/v3/properties/deals/$1" | grep -q '^200$'; then echo "exists: $1"; return; fi
+  curl -sS -f "${H[@]}" -X POST https://api.hubapi.com/crm/v3/properties/deals \
+    -d "{\"name\":\"$1\",\"label\":\"$2\",\"type\":\"$3\",\"fieldType\":\"$4\",\"groupName\":\"dealinformation\",\"description\":\"$5\",\"hasUniqueValue\":false,\"formField\":false}" >/dev/null
+  echo "created: $1"
+}
+ensure hot_score_v1 "Hot score v1" number number "Day-1 hot-deal score (0-100), model v1 fitted 2026-10-01; written weekly by the new-deals write-back job from BigQuery hubspot.hot_deals_v1"
+ensure hot_flag_v1  "Hot deal v1"  bool   booleancheckbox "hot_score_v1 >= 45; written weekly by the new-deals write-back job"
diff --git a/writeback/deploy_job.sh b/writeback/deploy_job.sh
new file mode 100755
index 0000000..290fd6f
--- /dev/null
+++ b/writeback/deploy_job.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# deploy_job.sh — Cloud Run job for the write-back + Cloud Scheduler → jobs.run. Create-or-update everywhere.
+#   writeback/deploy_job.sh            deploy (WRITEBACK_APPROVE stays 0 → dry executions)
+#   writeback/deploy_job.sh execute    run once now and wait (dry unless WRITEBACK_APPROVE=1 was set on the job)
+#   writeback/deploy_job.sh live       flip WRITEBACK_APPROVE=1 on the job (the gate)
+#   DRYRUN=1 …                         print the commands
+# Settings from ../.env: PROJECT REGION DATASET HUBSPOT_WRITE_TOKEN_VERSION (pinned Secret Manager version of hubspot-token-write)
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; ROOT="$(cd "$HERE/.." && pwd)"
+[[ -f "$ROOT/.env" ]] && { set -a; . "$ROOT/.env"; set +a; }
+: "${PROJECT:?}" "${REGION:=europe-west6}" "${DATASET:=hubspot}" "${BQ_LOCATION:=EU}" "${JOB:=new-deals-writeback}" "${WRITEBACK_SCHEDULE:=30 5 * * 1}"
+DRYRUN="${DRYRUN:-0}"
+SA="new-deals-writeback@${PROJECT}.iam.gserviceaccount.com"; SCHED_SA="new-deals-scheduler@${PROJECT}.iam.gserviceaccount.com"
+run() { if [[ "$DRYRUN" == 1 ]]; then printf '  $'; printf ' %q' "$@"; echo; else "$@"; fi; }
+ensure_sa() { if [[ "$DRYRUN" == 1 ]] || ! gcloud iam service-accounts describe "$1@${PROJECT}.iam.gserviceaccount.com" --project "$PROJECT" >/dev/null 2>&1; then run gcloud iam service-accounts create "$1" --project "$PROJECT" --display-name "$2"; fi; }
+
+case "${1:-deploy}" in
+  deploy)
+    : "${HUBSPOT_WRITE_TOKEN_VERSION:?pin a Secret Manager version of hubspot-token-write (not latest)}"
+    ensure_sa new-deals-writeback "new deals write-back job"; ensure_sa new-deals-scheduler "scheduler invoker for jobs.run"
+    run gcloud projects add-iam-policy-binding "$PROJECT" --member "serviceAccount:$SA" --role roles/bigquery.jobUser --condition=None
+    run bq --project_id="$PROJECT" --location="$BQ_LOCATION" query --use_legacy_sql=false "GRANT \`roles/bigquery.dataEditor\` ON SCHEMA \`${PROJECT}.${DATASET}\` TO \"serviceAccount:${SA}\""
+    run gcloud secrets add-iam-policy-binding hubspot-token-write --project "$PROJECT" --member "serviceAccount:$SA" --role roles/secretmanager.secretAccessor
+    run gcloud run jobs deploy "$JOB" --project "$PROJECT" --region "$REGION" --source "$HERE" --service-account "$SA" \
+      --tasks 1 --max-retries 2 --task-timeout 900s \
+      --set-env-vars "BQ_PROJECT=${PROJECT},BQ_DATASET=${DATASET},WRITEBACK_APPROVE=${WRITEBACK_APPROVE:-0}" \
+      --set-secrets "HUBSPOT_TOKEN=hubspot-token-write:${HUBSPOT_WRITE_TOKEN_VERSION}"
+    run gcloud run jobs add-iam-policy-binding "$JOB" --project "$PROJECT" --region "$REGION" --member "serviceAccount:$SCHED_SA" --role roles/run.invoker
+    URI="https://run.googleapis.com/v2/projects/${PROJECT}/locations/${REGION}/jobs/${JOB}:run"
+    ARGS=(--project "$PROJECT" --location "$REGION" --schedule "$WRITEBACK_SCHEDULE" --time-zone "Europe/Zurich" --uri "$URI" --http-method POST --oauth-service-account-email "$SCHED_SA" --max-retry-attempts 3)
+    if [[ "$DRYRUN" != 1 ]] && gcloud scheduler jobs describe "$JOB" --project "$PROJECT" --location "$REGION" >/dev/null 2>&1; then run gcloud scheduler jobs update http "$JOB" "${ARGS[@]}"; else run gcloud scheduler jobs create http "$JOB" "${ARGS[@]}"; fi
+    echo "dry execution now:  writeback/deploy_job.sh execute      (WRITEBACK_APPROVE=0 → rows logged with status DRY)"
+    echo "go live:            writeback/deploy_job.sh live" ;;
+  execute) run gcloud run jobs execute "$JOB" --project "$PROJECT" --region "$REGION" --wait ;;
+  live)    run gcloud run jobs update "$JOB" --project "$PROJECT" --region "$REGION" --update-env-vars WRITEBACK_APPROVE=1 ;;
+  *) sed -n '2,8p' "$0"; exit 1 ;;
+esac
diff --git a/writeback/index.mjs b/writeback/index.mjs
new file mode 100644
index 0000000..4177c90
--- /dev/null
+++ b/writeback/index.mjs
@@ -0,0 +1,57 @@
+// new-deals write-back (scenario C, layer L10). Node 22 Cloud Run *job*: no HTTP surface, started by Cloud Scheduler via jobs.run.
+// Reads the delta view (rows whose computed hot score differs from what HubSpot holds), PATCHes deals in batches of 100,
+// logs one row per deal to writeback_log. Idempotent: a same-value PATCH is a projection (f(f(x)) = f(x)); unchanged rows are
+// skipped by the view anyway; a NULL score is never sent (it would clear the property). Gate: WRITEBACK_APPROVE unset → DRY.
+import { BigQuery } from '@google-cloud/bigquery';
+
+const { BQ_PROJECT, BQ_DATASET = 'hubspot', HUBSPOT_TOKEN, WRITEBACK_APPROVE, BATCH_PAUSE_MS = '600', MAX_ROWS } = process.env;
+if (!BQ_PROJECT) throw new Error('BQ_PROJECT is required');
+const DRY = WRITEBACK_APPROVE !== '1';
+if (!DRY && !HUBSPOT_TOKEN) throw new Error('HUBSPOT_TOKEN is required when WRITEBACK_APPROVE=1');
+const HS = 'https://api.hubapi.com';
+const RUN_TS = new Date(); RUN_TS.setUTCMilliseconds(0);
+const bq = new BigQuery({ projectId: BQ_PROJECT });
+const T = (n) => `\`${BQ_PROJECT}.${BQ_DATASET}.${n}\``;
+const log = (o) => console.log(JSON.stringify({ severity: 'INFO', run_ts: RUN_TS.toISOString(), ...o }));
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+const [rows] = await bq.query({ query: `SELECT deal_id, hot_score_v1, hot_flag_v1, previous_score, previous_flag FROM ${T('hot_deals_v1_writeback')} ORDER BY deal_id${MAX_ROWS ? ` LIMIT ${Number(MAX_ROWS)}` : ''}` });
+log({ message: 'candidates', candidates: rows.length, dry_run: DRY });
+
+// POST /crm/v3/objects/deals/batch/update — ≤ 100 inputs; 200 = all written, 207 = partial (errors[] names the ids that failed).
+async function patchBatch(batch) {
+  const body = { inputs: batch.map((r) => ({ id: String(r.deal_id), properties: { hot_score_v1: String(r.hot_score_v1), hot_flag_v1: r.hot_flag_v1 ? 'true' : 'false' } })) };
+  for (let attempt = 1; attempt <= 5; attempt++) {
+    const res = await fetch(`${HS}/crm/v3/objects/deals/batch/update`, {
+      method: 'POST', headers: { Authorization: `Bearer ${HUBSPOT_TOKEN}`, 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+    });
+    if (res.status === 429 || res.status >= 500) {          // honour the rate-limit interval header, then retry with backoff
+      const wait = Number(res.headers.get('x-hubspot-ratelimit-interval-milliseconds') || res.headers.get('retry-after') * 1000 || 10000) * attempt;
+      console.warn(JSON.stringify({ severity: 'WARNING', message: `HTTP ${res.status}`, attempt, wait_ms: wait }));
+      await sleep(Math.min(wait, 60000)); continue;
+    }
+    const json = await res.json().catch(() => ({}));
+    if (res.status === 403) throw new Error(`403 from HubSpot — the token lacks crm.objects.deals.write (${JSON.stringify(json).slice(0, 300)})`);
+    const failed = new Set((json.errors || []).flatMap((e) => (e.context?.ids || e.context?.objectIds || []).map(String)));
+    return batch.map((r) => ({ ...r, http_status: res.status,
+      status: res.ok && !failed.has(String(r.deal_id)) ? 'OK' : 'ERROR',
+      error: res.ok ? (failed.has(String(r.deal_id)) ? JSON.stringify(json.errors).slice(0, 1000) : null) : JSON.stringify(json).slice(0, 1000) }));
+  }
+  return batch.map((r) => ({ ...r, http_status: 0, status: 'ERROR', error: 'retries exhausted' }));
+}
+
+const results = [];
+for (let i = 0; i < rows.length; i += 100) {
+  const batch = rows.slice(i, i + 100);
+  results.push(...(DRY ? batch.map((r) => ({ ...r, http_status: null, status: 'DRY', error: null })) : await patchBatch(batch)));
+  if (!DRY && i + 100 < rows.length) await sleep(Number(BATCH_PAUSE_MS));   // ≈ 17 calls / 10 s, well under the 190 / 10 s burst limit
+}
+if (results.length) {
+  await bq.dataset(BQ_DATASET).table('writeback_log').insert(results.map((r) => ({
+    run_ts: RUN_TS.toISOString(), deal_id: String(r.deal_id), hot_score_v1: r.hot_score_v1, hot_flag_v1: r.hot_flag_v1,
+    previous_score: r.previous_score ?? null, previous_flag: r.previous_flag ?? null,
+    status: r.status, http_status: r.http_status, error: r.error, dry_run: DRY })));
+}
+const summary = { message: 'summary', patched: results.filter((r) => r.status === 'OK').length, errors: results.filter((r) => r.status === 'ERROR').length, dry: results.filter((r) => r.status === 'DRY').length };
+log(summary);
+if (summary.errors) process.exit(1);   // non-zero → Cloud Run retries the task (--max-retries); OK rows are logged, so the retry PATCHes only the rest
