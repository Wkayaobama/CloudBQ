+  STRUCT('not_scored_pipeline_wisekey' AS id, '705868909' AS pipeline, '0.9' AS prob, NULL AS closedate, NULL AS calc_2026, NULL AS services_2026, '5000' AS arr, NULL AS tpm, NULL AS product_hierarchy, NULL AS notes, NULL AS notes_last_updated, NULL AS revenue_state, NULL AS exp_score, NULL AS exp_hot),
+  STRUCT('not_scored_pipeline_icalps' AS id, '766126206' AS pipeline, '0.9' AS prob, NULL AS closedate, NULL AS calc_2026, NULL AS services_2026, NULL AS arr, NULL AS tpm, NULL AS product_hierarchy, NULL AS notes, NULL AS notes_last_updated, NULL AS revenue_state, NULL AS exp_score, NULL AS exp_hot)
