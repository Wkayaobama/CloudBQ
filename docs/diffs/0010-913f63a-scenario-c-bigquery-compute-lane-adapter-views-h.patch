+++ b/sql/deals_synced_v1.sql
@@ -0,0 +1,55 @@
+-- Adapter views over the HubSpot → BigQuery sync (scenario C, layer L4). The connector decides the raw names and types;
+-- these views are the single place that knows them, so every downstream object reads stable names.
+-- ${SYNC_DATASET}.${SYNC_DEALS_TABLE} / ${SYNC_OWNERS_TABLE} are filled from .env after the first transfer run
+-- (Google DTS HubSpot connector: native tables per asset; HubSpot Data Hub sync: external tables in hubspot_data_set_<hubId>).
+-- SAFE_CAST tolerates either typing. Deals outside the five known pipelines pass through and are filtered downstream.
+CREATE OR REPLACE VIEW `${PROJECT}.${DATASET}.deals_synced_v1` AS
+SELECT
+  CAST(hs_object_id AS STRING)                                   AS deal_id,
+  CAST(pipeline AS STRING)                                       AS pipeline_id,
+  CAST(dealstage AS STRING)                                      AS dealstage_id,
+  CAST(dealname AS STRING)                                       AS dealname,
+  CAST(final_customer AS STRING)                                 AS final_customer,
+  CAST(sales_region AS STRING)                                   AS sales_region,
+  CAST(deal_currency_code AS STRING)                             AS currency,
+  CAST(product_hierarchy AS STRING)                              AS product_hierarchy,
+  CAST(prod___product_name_new_ AS STRING)                       AS product,
+  CAST(application AS STRING)                                    AS application,
+  CAST(icalps_dealtype AS STRING)                                AS icalps_dealtype,
+  CAST(icalps_stage AS STRING)                                   AS icalps_stage,
+  CAST(icalps_dealstatus AS STRING)                              AS icalps_dealstatus,
+  CAST(revenue_state AS STRING)                                  AS revenue_state,
+  CAST(hs_object_source_label AS STRING)                         AS source,
+  CAST(hs_created_by_user_id AS STRING)                          AS created_by_user_id,
+  CAST(hubspot_owner_id AS STRING)                               AS owner_id,
+  SAFE_CAST(createdate AS TIMESTAMP)                             AS createdate,
+  SAFE_CAST(closedate AS TIMESTAMP)                              AS closedate,
+  SAFE_CAST(notes_last_updated AS TIMESTAMP)                     AS notes_last_updated,
+  SAFE_CAST(hs_lastmodifieddate AS TIMESTAMP)                    AS lastmodified,
+  SAFE_CAST(hs_deal_stage_probability AS FLOAT64)                AS stage_probability,
+  SAFE_CAST(amount AS FLOAT64)                                   AS amount,
+  SAFE_CAST(amount_in_home_currency AS FLOAT64)                  AS amount_kusd,
+  SAFE_CAST(asp_in_usd_q2_2022_calculation AS FLOAT64)           AS asp_in_usd_q2_2022_calculation,
+  SAFE_CAST(tpm__k_y AS FLOAT64)                                 AS tpm__k_y,
+  SAFE_CAST(services_value_2026 AS FLOAT64)                      AS services_value_2026,
+  SAFE_CAST(calculation___pipeline_2026__k__ AS FLOAT64)         AS calculation___pipeline_2026__k__,
+  SAFE_CAST(num_contacted_notes AS FLOAT64)                      AS num_contacted_notes,
+  -- the written-back properties, once they exist in HubSpot and in the sync (NULL before the first write-back)
+  SAFE_CAST(hot_score_v1 AS FLOAT64)                             AS hot_score_v1_synced,
+  SAFE_CAST(hot_flag_v1 AS BOOL)                                 AS hot_flag_v1_synced
+FROM `${PROJECT}.${SYNC_DATASET}.${SYNC_DEALS_TABLE}`
+WHERE hs_object_id IS NOT NULL;
+
+CREATE OR REPLACE VIEW `${PROJECT}.${DATASET}.owners_synced_v1` AS
+SELECT CAST(id AS STRING) AS owner_id,
+       NULLIF(TRIM(CONCAT(IFNULL(CAST(firstName AS STRING), ''), ' ', IFNULL(CAST(lastName AS STRING), ''))), '') AS owner_name,
+       CAST(email AS STRING) AS owner_email
+FROM `${PROJECT}.${SYNC_DATASET}.${SYNC_OWNERS_TABLE}`;
+
+-- pipeline and stage labels are not a sync asset: sql/refresh_pipeline_labels.sh loads them from GET /crm/v3/pipelines/deals
+CREATE TABLE IF NOT EXISTS `${PROJECT}.${DATASET}.pipeline_labels` (
+  pipeline_id STRING NOT NULL, pipeline_label STRING, stage_id STRING, stage_label STRING, stage_probability FLOAT64, refreshed_at TIMESTAMP);
+CREATE OR REPLACE VIEW `${PROJECT}.${DATASET}.pipelines_synced_v1` AS
+SELECT DISTINCT pipeline_id, pipeline_label AS label FROM `${PROJECT}.${DATASET}.pipeline_labels`;
+CREATE OR REPLACE VIEW `${PROJECT}.${DATASET}.pipeline_stages_synced_v1` AS
+SELECT stage_id, stage_label AS label, pipeline_id FROM `${PROJECT}.${DATASET}.pipeline_labels` WHERE stage_id IS NOT NULL;
diff --git a/sql/hot_deals_v1.sql b/sql/hot_deals_v1.sql
new file mode 100644
index 0000000..1f21241
--- /dev/null
+++ b/sql/hot_deals_v1.sql
@@ -0,0 +1,36 @@
+-- Versioned scoring views (scenario C, layer L5/L6). v1 is never edited in place: a new fit is hot_score_v2 + hot_deals_v2.
+-- Needs scoring/hot_score_v1.sql (the UDF) and sql/deals_synced_v1.sql applied first (sql/apply.sh does it in order).
+CREATE OR REPLACE VIEW `${PROJECT}.${DATASET}.hot_deals_v1` AS
+WITH scored AS (
+  SELECT d.*,
+         `${PROJECT}.${DATASET}.hot_score_v1`(d.pipeline_id, d.stage_probability, d.closedate, d.calculation___pipeline_2026__k__,
+            d.services_value_2026, d.asp_in_usd_q2_2022_calculation, d.tpm__k_y, d.product_hierarchy, d.num_contacted_notes,
+            d.notes_last_updated, d.revenue_state, CURRENT_TIMESTAMP()) AS hs
+  FROM `${PROJECT}.${DATASET}.deals_synced_v1` d
+  LEFT JOIN `${PROJECT}.${DATASET}.pipeline_stages_synced_v1` st ON st.stage_id = d.dealstage_id
+  WHERE d.pipeline_id IN ('12096408', '13772279')                                   -- scored pipelines only (main.py CR)
+    AND NOT REGEXP_CONTAINS(LOWER(IFNULL(st.label, '')), r'closed')                -- open deals only; label from pipeline_labels
+)
+SELECT deal_id, dealname, final_customer, sales_region, pipeline_id, amount_kusd, closedate,
+       hs.score AS hot_score_v1, hs.hot AS hot_flag_v1,
+       ROW_NUMBER() OVER (PARTITION BY sales_region ORDER BY hs.score DESC, amount_kusd DESC, deal_id) AS region_rank,
+       RANK()       OVER (ORDER BY hs.score DESC, amount_kusd DESC)                                       AS global_rank,
+       hot_score_v1_synced, hot_flag_v1_synced
+FROM scored;
+
+-- per-region top-5: the arithmetic HubSQL cannot do (window functions)
+CREATE OR REPLACE VIEW `${PROJECT}.${DATASET}.hot_deals_v1_top5_by_region` AS
+SELECT * FROM `${PROJECT}.${DATASET}.hot_deals_v1` QUALIFY region_rank <= 5;
+
+-- rows the write-back must PATCH: the computed value differs from what HubSpot holds (last successful write-back, else the synced property).
+-- Never a NULL score: sending "" would clear the property on unscored pipelines.
+CREATE OR REPLACE VIEW `${PROJECT}.${DATASET}.hot_deals_v1_writeback` AS
+SELECT h.deal_id, h.hot_score_v1, h.hot_flag_v1,
+       COALESCE(w.last.hot_score_v1, h.hot_score_v1_synced) AS previous_score,
+       COALESCE(w.last.hot_flag_v1,  h.hot_flag_v1_synced)  AS previous_flag
+FROM `${PROJECT}.${DATASET}.hot_deals_v1` h
+LEFT JOIN (SELECT deal_id, ARRAY_AGG(STRUCT(hot_score_v1, hot_flag_v1) ORDER BY run_ts DESC LIMIT 1)[OFFSET(0)] AS last
+           FROM `${PROJECT}.${DATASET}.writeback_log` WHERE status = 'OK' AND NOT dry_run GROUP BY deal_id) w USING (deal_id)
+WHERE h.hot_score_v1 IS NOT NULL
+  AND (h.hot_score_v1 IS DISTINCT FROM COALESCE(w.last.hot_score_v1, h.hot_score_v1_synced)
+    OR h.hot_flag_v1  IS DISTINCT FROM COALESCE(w.last.hot_flag_v1,  h.hot_flag_v1_synced));
diff --git a/sql/new_deals_weekly.sql b/sql/new_deals_weekly.sql
new file mode 100644
index 0000000..b66b92e
--- /dev/null
+++ b/sql/new_deals_weekly.sql
@@ -0,0 +1,86 @@
+-- Scenario C scheduled script: window → shape → duplicates → MERGE → history → run log → state, in ONE transaction.
+-- Registered per entity by sql/scheduled_query.sh (${ENTITY}, ${PIPELINES} substituted); @run_time is BigQuery's parameter.
+-- Idempotent: the batch is a pure function of (synced state, @run_time); replaying a run_time rewrites the same slices.
+DECLARE entity STRING DEFAULT '${ENTITY}';
+DECLARE pipelines ARRAY<STRING> DEFAULT ${PIPELINES};
+DECLARE lookback_days INT64 DEFAULT 14;                        -- replaces the watermark search; MERGE absorbs the overlap
+DECLARE run_ts TIMESTAMP DEFAULT TIMESTAMP_TRUNC(@run_time, SECOND);
+DECLARE freshest TIMESTAMP;
+DECLARE t0 TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
+
+-- freshness guard: never MERGE a stale sync (the sync is scheduled, never real-time)
+SET freshest = (SELECT MAX(lastmodified) FROM `${PROJECT}.${DATASET}.deals_synced_v1`);
+IF freshest IS NULL OR freshest < TIMESTAMP_SUB(run_ts, INTERVAL 36 HOUR) THEN
+  INSERT INTO `${PROJECT}.${DATASET}.new_deals_runs` (run_ts, entity, mode, dry_run, orchestrator, status, error, duration_ms)
+  VALUES (run_ts, entity, 'window', FALSE, 'bigquery-scheduled-query', 'ABORTED', 'deals sync older than 36h', 0);
+  RAISE USING MESSAGE = 'deals sync is older than 36h; aborting run';
+END IF;
+
+BEGIN TRANSACTION;
+
+CREATE TEMP TABLE batch AS
+WITH recent AS (
+  SELECT *, SUBSTR(REGEXP_REPLACE(LOWER(COALESCE(NULLIF(TRIM(final_customer), ''), REGEXP_EXTRACT(dealname, r'^[^-/|(]*'))), r'[^a-z0-9]', ''), 1, 40) AS name_key
+  FROM `${PROJECT}.${DATASET}.deals_synced_v1`
+  WHERE createdate >= TIMESTAMP_SUB(run_ts, INTERVAL 90 DAY) AND createdate < run_ts     -- duplicate horizon = main.py recent_names(days=90)
+), win AS (
+  SELECT * FROM recent WHERE createdate >= TIMESTAMP_SUB(run_ts, INTERVAL lookback_days DAY) AND pipeline_id IN UNNEST(pipelines)
+), dups AS (
+  SELECT w.deal_id, STRING_AGG(r.deal_id, ', ' ORDER BY r.createdate) AS duplicate_of
+  FROM win w JOIN recent r ON r.name_key = w.name_key AND r.deal_id <> w.deal_id AND w.name_key <> ''
+  GROUP BY w.deal_id
+)
+SELECT entity, w.deal_id, w.dealname, w.final_customer, w.name_key,
+       w.createdate, w.created_by_user_id, w.source,
+       COALESCE(o.owner_name, w.owner_id) AS owner, w.sales_region,
+       COALESCE(p.label, w.pipeline_id) AS pipeline, w.pipeline_id, COALESCE(s.label, w.dealstage_id) AS stage,
+       ROUND(IFNULL(w.stage_probability, 0) * 100, 1) AS probability_pct, IFNULL(w.amount, 0) AS amount, w.currency,
+       IFNULL(w.amount_kusd, 0) AS amount_kusd, DATE(w.closedate) AS closedate,
+       IFNULL(w.asp_in_usd_q2_2022_calculation, 0) AS arr_ky, w.product_hierarchy AS product_family, w.product, w.application,
+       w.icalps_dealtype, w.icalps_stage,
+       hs.score AS day1_hot_score, hs.hot AS day1_hot_flag,
+       d.duplicate_of IS NOT NULL AS duplicate_suspect, d.duplicate_of,
+       CONCAT('https://app.hubspot.com/go-to/${PORTAL_ID}/0-3/', w.deal_id) AS deal_url,
+       run_ts AS first_seen_run, run_ts AS last_seen_run
+FROM win w
+LEFT JOIN dups d USING (deal_id)
+LEFT JOIN `${PROJECT}.${DATASET}.owners_synced_v1` o ON o.owner_id = w.owner_id
+LEFT JOIN `${PROJECT}.${DATASET}.pipelines_synced_v1` p ON p.pipeline_id = w.pipeline_id
+LEFT JOIN `${PROJECT}.${DATASET}.pipeline_stages_synced_v1` s ON s.stage_id = w.dealstage_id,
+UNNEST([`${PROJECT}.${DATASET}.hot_score_v1`(w.pipeline_id, w.stage_probability, w.closedate, w.calculation___pipeline_2026__k__,
+        w.services_value_2026, w.asp_in_usd_q2_2022_calculation, w.tpm__k_y, w.product_hierarchy, w.num_contacted_notes,
+        w.notes_last_updated, w.revenue_state, run_ts)]) AS hs;
+
+-- L7: MERGE on deal_id; deal_id, first_seen_run and the day-1 score are never overwritten (same frozen set as main.py after G06)
+MERGE `${PROJECT}.${DATASET}.new_deals` t USING batch s ON t.deal_id = s.deal_id
+WHEN MATCHED THEN UPDATE SET
+  entity = s.entity, dealname = s.dealname, final_customer = s.final_customer, name_key = s.name_key, createdate = s.createdate,
+  created_by_user_id = s.created_by_user_id, source = s.source, owner = s.owner, sales_region = s.sales_region, pipeline = s.pipeline,
+  pipeline_id = s.pipeline_id, stage = s.stage, probability_pct = s.probability_pct, amount = s.amount, currency = s.currency,
+  amount_kusd = s.amount_kusd, closedate = s.closedate, arr_ky = s.arr_ky, product_family = s.product_family, product = s.product,
+  application = s.application, icalps_dealtype = s.icalps_dealtype, icalps_stage = s.icalps_stage,
+  duplicate_suspect = s.duplicate_suspect, duplicate_of = s.duplicate_of, deal_url = s.deal_url, last_seen_run = s.last_seen_run
+WHEN NOT MATCHED THEN INSERT ROW;
+
+-- L13: per-deal history slice (replay of the same run_ts replaces it) and one summary row
+DELETE FROM `${PROJECT}.${DATASET}.new_deals_history` WHERE run_ts = run_ts AND entity = entity;
+INSERT INTO `${PROJECT}.${DATASET}.new_deals_history`
+SELECT run_ts, entity, 'bigquery-scheduled-query', * EXCEPT(entity) FROM batch;
+
+DELETE FROM `${PROJECT}.${DATASET}.new_deals_runs` WHERE run_ts = run_ts AND entity = entity AND orchestrator = 'bigquery-scheduled-query';
+INSERT INTO `${PROJECT}.${DATASET}.new_deals_runs`
+  (run_ts, entity, mode, dry_run, orchestrator, watermark_in, query_start, query_end, row_count, rows_written, duplicate_suspects, day1_hot, status, error, duration_ms)
+SELECT run_ts, entity, 'window', FALSE, 'bigquery-scheduled-query',
+       (SELECT watermark FROM `${PROJECT}.${DATASET}.report_state` WHERE report_id = CONCAT('NEW_DEALS_', entity, '_C')),
+       TIMESTAMP_SUB(run_ts, INTERVAL lookback_days DAY), run_ts,
+       COUNT(*), COUNT(*), COUNTIF(duplicate_suspect), COUNTIF(day1_hot_flag), 'OK', NULL,
+       TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), t0, MILLISECOND)
+FROM batch;
+
+-- L8: state advances inside the same transaction as the MERGE (engine-enforced "only after"); C keeps its own report_id
+MERGE `${PROJECT}.${DATASET}.report_state` t
+USING (SELECT CONCAT('NEW_DEALS_', entity, '_C') AS report_id, run_ts AS watermark) s ON t.report_id = s.report_id
+WHEN MATCHED THEN UPDATE SET watermark = s.watermark, updated_at = CURRENT_TIMESTAMP()
+WHEN NOT MATCHED THEN INSERT (report_id, watermark, updated_at) VALUES (s.report_id, s.watermark, CURRENT_TIMESTAMP());
+
+COMMIT TRANSACTION;
