+<script>
+(() => {
+  const M = /*__MANIFEST__*/;
+  const $ = (s) => document.querySelector(s);
+  const scenarioIds = Object.keys(M.scenarios || {});
+  const state = { scenario: M.scenario_filter || 'all', statuses: new Set(M.statuses), q: '', selected: null, collapsed: new Set() };
+  try { const s = localStorage.getItem('treef.scenario'); if (s && (s === 'all' || scenarioIds.includes(s))) state.scenario = s; } catch (e) {}
+
+  // ---- filtering -----------------------------------------------------------------------------
+  const matches = (n) => {
+    const a = n.ann || {};
+    const stOk = state.statuses.has(a.status || 'existing');
+    const scOk = state.scenario === 'all' || (a.scenarios || []).includes(state.scenario);
+    const qOk = !state.q || n.path.toLowerCase().includes(state.q);
+    return stOk && scOk && qOk;
+  };
+  const prune = (n) => {
+    if (n.kind === 'dir') {
+      const kids = (n.children || []).map(prune).filter(Boolean);
+      const own = matches(n) && (state.scenario === 'all' || n.ann);
+      if (kids.length || own) return Object.assign({}, n, { children: kids });
+      return null;
+    }
+    return matches(n) ? n : null;
+  };
+  const view = () => { const t = prune(M.tree); return t || Object.assign({}, M.tree, { children: [] }); };
+
+  // ---- tree /f text (same algorithm as scripts/tree_f.py) --------------------------------------
+  const ascii = (t) => {
+    const out = [`Folder PATH listing for volume ${M.volume}`, `Volume serial number is ${M.serial}`, M.root_label];
+    const emit = (d, prefix) => {
+      const kids = d.children || [], files = kids.filter(k => k.kind !== 'dir'), dirs = kids.filter(k => k.kind === 'dir');
+      const col = dirs.length ? '│   ' : '    ';
+      for (const f of files) out.push(prefix + col + f.name);
+      if (dirs.length) {
+        if (files.length) out.push(prefix + '│');
+        dirs.forEach((sub, i) => { const last = i === dirs.length - 1; out.push(prefix + (last ? '└───' : '├───') + sub.name); emit(sub, prefix + (last ? '    ' : '│   ')); });
+      } else out.push(prefix.replace(/\s+$/, ''));
+    };
+    emit(t, '');
+    return out.join('\n') + '\n';
+  };
+
+  // ---- rendering ---------------------------------------------------------------------------------
+  const esc = (s) => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
+  const nameHtml = (n) => {
+    const a = n.ann || {}; const st = a.status || 'existing'; const proposed = n.exists === false || st === 'proposed';
+    const dot = a.parity ? `<i class="dot ${a.parity}" title="${a.parity}"></i>` : (n.ann ? '<i class="dot none"></i>' : '');
+    const tag = st !== 'existing' ? `<span class="st ${st}">${st}</span>` : '';
+    return `${dot}<span class="nm${proposed ? ' proposed' : ''}">${esc(n.name)}</span>${tag}`;
+  };
+  const render = () => {
+    const t = view(); const pre = $('#tree'); const rows = [];
+    rows.push(`<span class="hdr">Folder PATH listing for volume ${esc(M.volume)}\nVolume serial number is ${esc(M.serial)}</span>\n`);
+    rows.push(`<span class="row dir${state.selected === t.path ? ' selected' : ''}" data-path="${esc(t.path)}" tabindex="0">${esc(M.root_label)}</span>\n`);
+    const emit = (d, prefix) => {
+      const kids = d.children || [], files = kids.filter(k => k.kind !== 'dir'), dirs = kids.filter(k => k.kind === 'dir');
+      const col = dirs.length ? '│   ' : '    ';
+      for (const f of files) rows.push(`<span class="g">${esc(prefix + col)}</span><span class="row file${state.selected === f.path ? ' selected' : ''}" data-path="${esc(f.path)}" tabindex="0">${nameHtml(f)}</span>\n`);
+      if (dirs.length) {
+        if (files.length) rows.push(`<span class="g">${esc(prefix + '│')}</span>\n`);
+        dirs.forEach((sub, i) => {
+          const last = i === dirs.length - 1; const folded = state.collapsed.has(sub.path);
+          const n = (sub.children || []).length;
+          rows.push(`<span class="g">${esc(prefix + (last ? '└───' : '├───'))}</span><span class="row dir${state.selected === sub.path ? ' selected' : ''}" data-path="${esc(sub.path)}" tabindex="0">${nameHtml(sub)}${folded ? ` <span class="fold">[+${n}]</span>` : ''}</span>\n`);
+          if (!folded) emit(sub, prefix + (last ? '    ' : '│   '));
+          else rows.push(`<span class="g">${esc((prefix + (last ? '    ' : '│   ')).replace(/\s+$/, ''))}</span>\n`);
+        });
+      } else rows.push(`<span class="g">${esc(prefix.replace(/\s+$/, ''))}</span>\n`);
+    };
+    emit(t, '');
+    pre.innerHTML = rows.join('');
+    const c = M.counts; const lab = state.scenario === 'all' ? 'all scenarios' : `scenario ${state.scenario}`;
+    $('#counts').textContent = `${c.dirs} folders · ${c.files} files · ${c.annotated} annotated · ${c.proposed} proposed · showing ${lab}`;
+    renderDetails();
+  };
+  const find = (path, n = M.tree) => { if (n.path === path) return n; for (const c of (n.children || [])) { const r = find(path, c); if (r) return r; } return null; };
+  const renderDetails = () => {
+    const box = $('#details'); const n = state.selected !== null ? find(state.selected) : null;
+    if (!n) { box.innerHTML = '<div class="empty">Select a file or folder to see its role, layer, status and parity.</div>'; return; }
+    const a = n.ann || {}; const st = a.status || (n.exists === false ? 'proposed' : 'existing');
+    const scen = (a.scenarios || []).map(s => `<span class="pill status">${esc(s)}</span> ${esc(M.scenarios[s] || '')}`).join('<br>');
+    const layer = a.layer ? `<code>${esc(a.layer)}</code> ${esc((M.layers || {})[a.layer] || '')}` : '';
+    box.innerHTML = `<h2>${esc(n.path || M.root_label)}</h2>
+      <div><span class="pill status ${st}">${st}</span> <span class="pill status">${n.kind}</span> ${a.parity ? `<span class="pill ${a.parity}">${a.parity}</span>` : ''}</div>
+      <dl>
+        ${a.role ? `<dt>Role</dt><dd>${esc(a.role)}</dd>` : ''}
+        ${scen ? `<dt>Scenarios</dt><dd>${scen}</dd>` : ''}
+        ${layer ? `<dt>Layer</dt><dd>${layer}</dd>` : ''}
+        ${a.notes ? `<dt>Notes</dt><dd>${esc(a.notes)}</dd>` : ''}
+        ${a.recipe ? `<dt>Recipe</dt><dd><code>${esc(a.recipe)}</code></dd>` : ''}
+        ${!n.ann ? `<dt>Annotation</dt><dd class="empty">none — add this path to the annotations file to describe it</dd>` : ''}
+      </dl>`;
+  };
+
+  // ---- controls ---------------------------------------------------------------------------------
+  const chip = (parent, id, label, pressed, onClick) => {
+    const b = document.createElement('button'); b.className = 'chip'; b.type = 'button'; b.textContent = label; b.dataset.id = id;
+    b.setAttribute('aria-pressed', String(pressed)); b.addEventListener('click', () => onClick(b)); parent.appendChild(b); return b;
+  };
+  const sc = $('#scenarios');
+  const scChips = [chip(sc, 'all', 'All', state.scenario === 'all', pick)].concat(scenarioIds.map(id => chip(sc, id, `${id} · ${M.scenarios[id]}`, state.scenario === id, pick)));
+  function pick(b) { state.scenario = b.dataset.id; scChips.forEach(c => c.setAttribute('aria-pressed', String(c === b))); try { localStorage.setItem('treef.scenario', state.scenario); } catch (e) {} render(); }
+  const stBox = $('#statuses');
+  M.statuses.forEach(s => chip(stBox, s, s, true, (b) => { const on = b.getAttribute('aria-pressed') !== 'true'; b.setAttribute('aria-pressed', String(on)); if (on) state.statuses.add(s); else state.statuses.delete(s); render(); }));
+  $('#q').addEventListener('input', (e) => { state.q = e.target.value.trim().toLowerCase(); render(); });
+  $('#tree').addEventListener('click', (e) => { const r = e.target.closest('.row'); if (!r) return; onRow(r, e); });
+  $('#tree').addEventListener('keydown', (e) => { const r = e.target.closest('.row'); if (!r) return; if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); onRow(r, e); } });
+  function onRow(r) {
+    const p = r.dataset.path; state.selected = p;
+    if (r.classList.contains('dir') && p !== '' && state.selected === p && r.dataset.toggled === '1') { /* second click toggles */ }
+    if (r.classList.contains('dir') && p !== '') { if (state.collapsed.has(p)) state.collapsed.delete(p); else state.collapsed.add(p); }
+    render();
+    const again = document.querySelector(`.row[data-path="${CSS.escape(p)}"]`); if (again) again.focus();
+  }
+  $('#expand').addEventListener('click', () => { state.collapsed.clear(); render(); });
+  $('#collapse').addEventListener('click', () => { const t = view(); const walk = (n, depth) => { if (n.kind === 'dir' && depth > 0) state.collapsed.add(n.path); (n.children || []).forEach(c => walk(c, depth + 1)); }; walk(t, 0); render(); });
+  const toast = (msg) => { const t = document.createElement('div'); t.className = 'toast'; t.textContent = msg; document.body.appendChild(t); setTimeout(() => t.remove(), 1600); };
+  $('#copy').addEventListener('click', () => {
+    const text = ascii(view());
+    const fallback = () => { const ta = $('#clip'); ta.value = text; ta.select(); try { document.execCommand('copy'); toast('Copied (fallback)'); } catch (e) { toast('Select the listing and copy manually'); } };
+    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(() => toast('Copied tree /f listing'), fallback); else fallback();
+  });
+  render();
+})();
+</script>
